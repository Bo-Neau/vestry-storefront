# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real tokens.
#
# With these unset the storefront runs on the local sample catalogue, so the
# app works before any Shopify account exists.
# ---------------------------------------------------------------------------

# Your dev store domain, without protocol.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# PUBLIC Storefront API token. Safe to expose to browsers.
# Must start with a plain hex string — NOT "shpat_" (that is an Admin token
# and the client refuses it, see src/data/shopify/client.ts).
SHOPIFY_STOREFRONT_TOKEN=

# Latest stable at time of writing (Aug 2026). Shopify ships a new version
# each quarter; bump deliberately, not automatically.
SHOPIFY_API_VERSION=2026-07

# ---------------------------------------------------------------------------
# ADMIN token — used ONLY by scripts/, never at runtime. Starts with shpat_.
# This one is secret. Treat it like a password.
# ---------------------------------------------------------------------------
SHOPIFY_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# OKENDO — reviews with structured fit attributes.
#
# Public and unauthenticated: this is a store id, not a secret. Leave unset
# and the sample reviews are used instead.
#
# Find it in Okendo under Settings → Integrations, or read it out of the
# okendo-reviews script tag on a live storefront.
# ---------------------------------------------------------------------------
OKENDO_USER_ID=

# ---------------------------------------------------------------------------
# IMAGES — defaults to the platform CDN, which needs no configuration.
# Set these only when moving to Cloudinary or imgix.
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=shopify
IMAGE_ACCOUNT=

# ---------------------------------------------------------------------------
# SITE — absolute base URL. Used for canonical tags, Open Graph and sitemap.
# Must match the deployed domain or those URLs point at the wrong place.
# ---------------------------------------------------------------------------
SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# SEARCH (Typesense). Unset = in-memory filtering, which is correct for a
# small catalogue. See docs/search-setup.md.
# ---------------------------------------------------------------------------
TYPESENSE_URL=
TYPESENSE_COLLECTION=products

# Search-only key. Safe to expose. Create with: npm run search:keys
TYPESENSE_SEARCH_KEY=

# Admin key — SECRET, used only by scripts/. Can delete collections.
TYPESENSE_ADMIN_KEY=
