---
/**
 * All collections.
 *
 * Presented as issues, in a fixed order, with no dates anywhere. That is the
 * whole point of the structure: a reader cannot tell whether the last one
 * landed last month or last year, so a slow season does not read as neglect.
 */
import Base from "../../layouts/Base.astro";
import Photo from "../../components/Photo.astro";
import JsonLd from "../../components/JsonLd.astro";
import { COLLECTIONS, designsIn } from "../../data/collections.ts";
import { designByHandle } from "../../data/designs.ts";
import { leadImage } from "../../data/journal.ts";
import { BRAND, pageTitle } from "../../config/brand.ts";
import { breadcrumbSchema } from "../../lib/seo/structured-data.ts";

const site = Astro.site ?? new URL("https://example.com");

const issues = COLLECTIONS.map((collection) => {
  const designs = designsIn(collection);
  const lead = designByHandle(collection.lead);
  return {
    collection,
    designs,
    photo: lead ? leadImage(lead) : undefined,
    // Count the hands, not just the pieces — it is the more interesting fact
    // about a collective, and it is true rather than editorialised.
    designers: [...new Set(designs.map((d) => d.designer))],
  };
});

const trail = [
  { name: BRAND.name, url: site.href },
  { name: "Collections", url: new URL("/collections", site).href },
];
---

<Base
  title={pageTitle("Collections")}
  description={`The collections of ${BRAND.name} — ${COLLECTIONS.length} bodies of work from the atelier in Yangon.`}
>
  <JsonLd data={breadcrumbSchema(trail)} />

  <div class="shell head">
    <p class="label">The house</p>
    <h1>Collections</h1>
    <p class="standfirst">
      Six bodies of work. Painted cloth, traditional weaves, and tailoring cut
      from both.
    </p>
  </div>

  <ul class="issues">
    {issues.map(({ collection, designs, photo, designers }, i) => (
      <li class="issue">
        <a href={`/collections/${collection.handle}`} class="issue-link">
          {photo && (
            <div class="issue-media">
              <Photo
                photo={photo}
                sizes="(max-width: 800px) 100vw, 420px"
                priority={i === 0}
                alt=""
              />
            </div>
          )}
          <div class="issue-body">
            <span class="issue-no">{collection.eyebrow}</span>
            <h2>{collection.title}</h2>
            <p class="issue-stand">{collection.standfirst}</p>
            <p class="issue-count">
              {designs.length} {designs.length === 1 ? "piece" : "pieces"}
              <span aria-hidden="true"> · </span>
              {designers.length} {designers.length === 1 ? "designer" : "designers"}
            </p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .head {
    padding-block: var(--sp-7) var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .head h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .standfirst {
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 44ch;
    line-height: 1.5;
  }

  .issues {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .issue { border-top: 1px solid var(--rule); }
  .issue:last-child { border-bottom: 1px solid var(--rule); }

  /*
    Each issue is one wide row rather than a card in a grid. A grid of six
    equal tiles reads as a shop; a stack of rows reads as a contents page,
    which is what this is.
  */
  .issue-link {
    display: grid;
    grid-template-columns: 420px minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: center;
    padding: var(--sp-5) var(--sp-4);
    max-width: 1200px;
    margin: 0 auto;
    text-decoration: none;
  }
  .issue-media { overflow: hidden; }
  .issue-media :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .issue-media :global(img) { transition: none; }
  }
  @media (hover: hover) {
    .issue-link:hover .issue-media :global(img) { transform: scale(1.03); }
    .issue-link:hover h2 { text-decoration: underline; text-underline-offset: 4px; }
  }

  .issue-body { display: flex; flex-direction: column; gap: var(--sp-2); }
  .issue-no {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }
  .issue-body h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .issue-stand {
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 40ch;
  }
  .issue-count {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    margin-top: var(--sp-2);
  }

  @media (max-width: 860px) {
    .issue-link {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-4);
      padding-block: var(--sp-5);
    }
    .issue-media :global(img) { aspect-ratio: 3 / 2; }
  }
</style>
