---
/**
 * One collection.
 *
 * A contents page for an issue: the standfirst, then every piece with its
 * designer credited under it. No filtering, no sorting — thirteen pieces
 * across six collections does not need faceting, and adding it would make a
 * small body of work feel like a warehouse.
 */
import Base from "../../layouts/Base.astro";
import Photo from "../../components/Photo.astro";
import JsonLd from "../../components/JsonLd.astro";
import { collectionByHandle, designsIn, COLLECTIONS } from "../../data/collections.ts";
import { leadImage } from "../../data/journal.ts";
import { designerByName } from "../../data/people.ts";
import { BRAND, pageTitle } from "../../config/brand.ts";
import { collectionSchema, breadcrumbSchema } from "../../lib/seo/structured-data.ts";

const collection = collectionByHandle(Astro.params.handle ?? "");
if (!collection) return Astro.rewrite("/404");

const site = Astro.site ?? new URL("https://example.com");
const url = new URL(`/collections/${collection.handle}`, site).href;

const designs = designsIn(collection);
const lead = designs.find((d) => d.handle === collection.lead) ?? designs[0];
const leadPhoto = lead ? leadImage(lead) : undefined;

// Where this issue sits in the run, so the reader can move through them.
const index = COLLECTIONS.findIndex((c) => c.handle === collection.handle);
const previous = index > 0 ? COLLECTIONS[index - 1] : undefined;
const next = index < COLLECTIONS.length - 1 ? COLLECTIONS[index + 1] : undefined;

const trail = [
  { name: BRAND.name, url: site.href },
  { name: "Collections", url: new URL("/collections", site).href },
  { name: collection.title, url },
];
---

<Base
  title={pageTitle(collection.title)}
  description={collection.standfirst}
  ogImage={leadPhoto?.src}
>
  <JsonLd data={collectionSchema(collection.title, collection.standfirst, url, site.href, designs)} />
  <JsonLd data={breadcrumbSchema(trail)} />

  <header class="issue-head">
    <div class="shell head-inner">
      <p class="label"><a href="/collections">Collections</a> <span aria-hidden="true">·</span> {collection.eyebrow}</p>
      <h1>{collection.title}</h1>
      <p class="standfirst">{collection.standfirst}</p>
      <div class="intro">
        {collection.description.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </header>

  <ul class="plates">
    {designs.map((design, i) => {
      const photo = leadImage(design);
      const designer = designerByName(design.designer);
      return (
        <li class="plate">
          <a href={`/pieces/${design.handle}`} class="plate-link">
            {photo && (
              <div class="plate-media">
                <Photo
                  photo={photo}
                  sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 460px"
                  priority={i === 0}
                  alt=""
                />
              </div>
            )}
            <div class="plate-body">
              <h2>{design.title}</h2>
              <p class="plate-sum">{design.summary}</p>
            </div>
          </a>
          <p class="plate-credit">
            {designer
              ? <a href={`/designers/${designer.slug}`}>{design.designer}</a>
              : design.designer}
            {design.artist && (
              <>
                <span aria-hidden="true"> · </span>
                <span class="painted">painted by {design.artist}</span>
              </>
            )}
          </p>
        </li>
      );
    })}
  </ul>

  <nav class="issue-nav shell" aria-label="Other collections">
    {previous ? (
      <a href={`/collections/${previous.handle}`} class="prev">
        <span class="dir">Previous</span>
        <span class="name">{previous.title}</span>
      </a>
    ) : <span></span>}
    {next && (
      <a href={`/collections/${next.handle}`} class="next">
        <span class="dir">Next</span>
        <span class="name">{next.title}</span>
      </a>
    )}
  </nav>
</Base>

<style>
  .issue-head { border-bottom: 1px solid var(--rule); }
  .head-inner {
    padding-block: var(--sp-7) var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    max-width: 760px;
  }
  .head-inner .label a {
    color: inherit;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .head-inner .label a:hover { color: var(--ink); }
  .head-inner h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 3.8rem);
    line-height: 1.0;
    letter-spacing: -0.028em;
  }
  .standfirst {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--ink-2);
    max-width: 32ch;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }
  .intro p { font-size: var(--step-0); line-height: 1.6; color: var(--ink-2); max-width: 62ch; }

  /*
    Two columns of large plates. The credit sits OUTSIDE the link, because a
    designer's name should go to the designer, not to the piece — nesting one
    anchor inside another is invalid and the browser resolves it by dropping
    the inner one.
  */
  .plates {
    list-style: none;
    margin: 0 auto;
    padding: var(--sp-7) var(--sp-4);
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--sp-7) var(--sp-5);
  }
  .plate { display: flex; flex-direction: column; gap: var(--sp-2); }
  .plate-link { display: flex; flex-direction: column; gap: var(--sp-3); text-decoration: none; }
  .plate-media { overflow: hidden; }
  .plate-media :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .plate-media :global(img) { transition: none; }
  }
  @media (hover: hover) {
    .plate-link:hover .plate-media :global(img) { transform: scale(1.03); }
    .plate-link:hover h2 { text-decoration: underline; text-underline-offset: 4px; }
  }
  .plate-body { display: flex; flex-direction: column; gap: var(--sp-2); }
  .plate-body h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .plate-sum { font-size: var(--step-0); color: var(--ink-2); max-width: 40ch; }
  .plate-credit {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    min-height: 24px;
  }
  .plate-credit a {
    color: var(--ink-2);
    text-underline-offset: 3px;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .plate-credit a:hover { color: var(--ink); }

  .issue-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-5);
    padding-block: var(--sp-6);
    border-top: 1px solid var(--rule);
  }
  .issue-nav a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    min-height: 44px;
    justify-content: center;
  }
  .issue-nav .next { text-align: right; }
  .dir {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }
  .name { font-family: var(--display); font-size: var(--step-1); }
  .issue-nav a:hover .name { text-decoration: underline; text-underline-offset: 4px; }
</style>
