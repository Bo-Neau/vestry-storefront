---
/**
 * Not found.
 *
 * A single-page site should rarely reach this, but a mistyped anchor or a
 * stale link from the brief will, and GitHub Pages serves 404.html for any
 * unmatched path. Everything worth reaching is one link away.
 */
import Base from "../layouts/Base.astro";
import { BRAND, NAV } from "../data/site.ts";
---
<Base
  title={`Page not found — ${BRAND.name}`}
  description="That page could not be found."
  noindex
>
  <section class="lost">
    <div class="shell lost-inner">
      <p class="eyebrow">404</p>
      <h1>That page is not here.</h1>
      <p class="lost-body">
        Everything about {BRAND.name} lives on one page. Try one of these.
      </p>
      <ul class="lost-links">
        <li><a href="/">The top of the page</a></li>
        {NAV.map((item) => <li><a href={`/${item.href}`}>{item.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .lost { padding-block: var(--sp-9); min-height: 60vh; display: flex; align-items: center; }
  .lost-inner { display: flex; flex-direction: column; gap: var(--sp-4); align-items: flex-start; }
  .lost h1 { font-size: var(--step-5); max-width: 14ch; }
  .lost-body { font-size: var(--step-1); color: var(--ink-2); max-width: 46ch; }
  .lost-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
    margin-top: var(--sp-3);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
  }
  .lost-links a {
    font-family: var(--display);
    font-size: var(--step-2);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
