---
import Base from "../layouts/Base.astro";
import { pageTitle } from "../config/brand.ts";

/**
 * Shown when a request throws.
 *
 * Deliberately says nothing about what failed. Stack traces and internal
 * messages belong in the server log, not on a page a stranger can load.
 */
Astro.response.status = 500;
---
<Base
  title={pageTitle("Something went wrong")}
  description="An unexpected error occurred."
  noindex
>
  <div class="shell err">
    <p class="label">Error 500</p>
    <h1>Something went wrong at our end</h1>
    <p class="err-msg">
      This one is on us, not you. Try again in a moment — if it keeps
      happening, your bag is saved and nothing has been charged.
    </p>
    <div class="err-actions">
      <a href="/" class="btn">Back to home</a>
      <a href="/cart" class="btn ghost">View your bag</a>
    </div>
  </div>
</Base>

<style>
  .err {
    padding-block: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    align-items: flex-start;
    max-width: 54ch;
  }
  h1 { font-size: var(--step-3); }
  .err-msg { color: var(--ink-2); }
  .err-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-2); }
  .btn {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    padding: var(--sp-3) var(--sp-5);
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .btn:hover { text-decoration: none; opacity: 0.88; }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--rule-2); }
</style>
