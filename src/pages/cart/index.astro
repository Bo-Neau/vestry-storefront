---
import Base from "../../layouts/Base.astro";
import Garment from "../../components/Garment.astro";
import { readCart } from "../../lib/cart/index.ts";
import { formatMoney } from "../../lib/money.ts";
import { MAX_QUANTITY_PER_LINE } from "../../lib/cart/types.ts";
import type { GarmentShape } from "../../data/schema.ts";
import { COMMERCE, COPY, shippingFor, pageTitle } from "../../config/brand.ts";

const cart = await readCart(Astro.cookies);
const removed = Astro.url.searchParams.has("removed");

// Shipping and the free-shipping threshold come from config, so the cart can
// never quote different terms from the header or the product page.
const shipping = shippingFor(cart.subtotal);
const toFreeShipping = COPY.amountToFreeShipping(cart.subtotal);
const total = cart.subtotal.amount + shipping.amount;

// Lines whose quantity now exceeds what is actually in stock.
const overstocked = cart.lines.filter((l) => l.quantity > l.available);
---

<Base title={pageTitle("Your bag")} description="Review your bag before checkout." noindex>
  <div class="shell cart-wrap">
    <h1>Your bag</h1>

    {removed && <p class="flash" role="status">Item removed.</p>}
    {cart.warning && <p class="flash warn" role="status">{cart.warning}</p>}

    {cart.lines.length === 0 ? (
      <div class="empty">
        <p>Your bag is empty.</p>
        <a href="/collections/all" class="btn">Continue shopping</a>
      </div>
    ) : (
      <div class="cart-grid">
        <section aria-label="Items in your bag">
          <ul class="lines">
            {cart.lines.map((line) => (
              <li class="line">
                <a href={`/products/${line.handle}?color=${line.colorwayId}`} class="thumb" aria-hidden="true" tabindex="-1">
                  {line.imageSrc ? (
                    <img src={line.imageSrc} alt="" width="120" height="156" loading="lazy" />
                  ) : (
                    <Garment shape={line.shape as GarmentShape} hex={line.hex} hexAlt={line.hexAlt} view="front" alt="" />
                  )}
                </a>

                <div class="line-body">
                  <h2 class="line-title">
                    <a href={`/products/${line.handle}?color=${line.colorwayId}`}>{line.title}</a>
                  </h2>
                  <p class="line-meta">{line.colorName} · Size {line.size}</p>
                  <p class="line-unit money">{formatMoney(line.unitPrice)} each</p>

                  {line.quantity > line.available && (
                    <p class="line-warn">
                      Only {line.available} left — reduce the quantity to continue.
                    </p>
                  )}

                  <form method="POST" action="/cart/update" class="qty-form">
                    <input type="hidden" name="id" value={line.id} />
                    <label class="sr-only" for={`qty-${line.id}`}>
                      Quantity for {line.title}, {line.colorName}, size {line.size}
                    </label>
                    <input
                      type="number"
                      id={`qty-${line.id}`}
                      name="quantity"
                      value={line.quantity}
                      min="1"
                      max={MAX_QUANTITY_PER_LINE}
                      inputmode="numeric"
                      class="qty"
                    />
                    <button type="submit" class="linkish">Update</button>
                    <button type="submit" name="remove" value="1" class="linkish danger">
                      Remove<span class="sr-only"> {line.title}, {line.colorName}, size {line.size}</span>
                    </button>
                  </form>
                </div>

                <p class="line-total money">{formatMoney(line.linePrice)}</p>
              </li>
            ))}
          </ul>
        </section>

        <aside class="summary" aria-label="Order summary">
          <h2>Summary</h2>

          <dl class="totals">
            <div><dt>Subtotal</dt><dd class="money">{formatMoney(cart.subtotal)}</dd></div>
            <div>
              <dt>Shipping</dt>
              <dd class="money">{shipping.amount === 0 ? "Free" : formatMoney(shipping)}</dd>
            </div>
            <div class="grand">
              <dt>Total</dt>
              <dd class="money">{formatMoney({ amount: total, currency: "USD" })}</dd>
            </div>
          </dl>

          <p class="tax-note">Taxes calculated at checkout.</p>

          {toFreeShipping && (
            <p class="free-ship">Spend {toFreeShipping} more for free shipping.</p>
          )}

          {overstocked.length > 0 ? (
            <p class="blocked" role="alert">
              Reduce quantities above before checking out.
            </p>
          ) : cart.checkoutUrl ? (
            <a href={cart.checkoutUrl} class="checkout" rel="nofollow">Checkout</a>
          ) : (
            <div class="no-checkout">
              <p class="checkout disabled" aria-disabled="true">Checkout</p>
              <p class="no-checkout-note">
                Checkout is handled by the commerce platform — payment, tax and
                fraud stay on their side. Connect a Shopify store and this
                becomes a live checkout link.
              </p>
            </div>
          )}

          <ul class="reassure">
            <li>{COPY.returnsShort}</li>
            {COMMERCE.exchangesSupported && <li>{COPY.exchangeShort}</li>}
          </ul>

          <a href="/collections/all" class="keep">Continue shopping</a>
        </aside>
      </div>
    )}
  </div>
</Base>

<style>
  .cart-wrap { padding-block: var(--sp-7) var(--sp-8); display: flex; flex-direction: column; gap: var(--sp-5); }
  h1 { font-size: var(--step-3); }

  .flash {
    font-size: var(--step--1);
    background: var(--paper-3);
    border-left: 3px solid var(--in-stock);
    padding: var(--sp-3) var(--sp-4);
    align-self: flex-start;
  }
  .flash.warn { border-left-color: var(--low-stock); }

  .empty { display: flex; flex-direction: column; gap: var(--sp-4); align-items: flex-start; padding-block: var(--sp-6); }
  .btn, .checkout, .keep {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .btn { background: var(--ink); color: var(--paper); padding: var(--sp-3) var(--sp-5); }
  .btn:hover { text-decoration: none; opacity: 0.88; }

  .cart-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
    gap: var(--sp-7);
    align-items: start;
  }

  .lines { list-style: none; display: flex; flex-direction: column; }
  .line {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) auto;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .thumb { display: block; background: var(--paper-3); }
  .thumb img { width: 100%; height: auto; aspect-ratio: 400 / 520; object-fit: cover; }

  .line-body { display: flex; flex-direction: column; gap: var(--sp-2); }
  .line-title { font-size: var(--step-0); }
  .line-title a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .line-meta { font-size: var(--step--1); color: var(--ink-2); }
  .line-unit { font-size: var(--step--1); color: var(--ink-3); }
  .line-warn { font-size: var(--step--1); color: var(--sale); font-weight: 600; }

  .qty-form { display: flex; align-items: center; gap: var(--sp-3); margin-top: var(--sp-2); flex-wrap: wrap; }
  .qty {
    width: 72px;
    min-height: 44px;
    padding: var(--sp-2);
    border: 1px solid var(--rule-2);
    background: var(--paper-2);
    color: var(--ink);
    font-family: var(--mono);
    /* 16px minimum, or iOS zooms on focus and does not zoom back. */
    font-size: max(16px, var(--step-0));
    text-align: center;
  }
  .linkish {
    background: none;
    border: none;
    min-height: 44px;
    padding: var(--sp-2) var(--sp-2);
    margin-inline: calc(-1 * var(--sp-2));
    cursor: pointer;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .linkish:hover { color: var(--ink); }
  .linkish.danger:hover { color: var(--sale); }

  .line-total { font-size: var(--step-0); white-space: nowrap; }

  .summary {
    border: 1px solid var(--rule);
    background: var(--paper-2);
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    position: sticky;
    top: 88px;
  }
  .summary h2 { font-size: var(--step-1); }

  .totals { display: flex; flex-direction: column; gap: var(--sp-2); }
  .totals > div { display: flex; justify-content: space-between; gap: var(--sp-3); font-size: var(--step--1); }
  .totals dd { margin: 0; }
  .grand { border-top: 1px solid var(--rule); padding-top: var(--sp-2); font-size: var(--step-0) !important; font-weight: 650; }

  .tax-note, .free-ship { font-size: var(--step--1); color: var(--ink-3); }
  .free-ship { color: var(--ink-2); }

  .checkout {
    background: var(--ink);
    color: var(--paper);
    padding: var(--sp-4);
    text-align: center;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .checkout:hover { text-decoration: none; opacity: 0.88; }
  .checkout.disabled { background: var(--out-stock); cursor: not-allowed; }

  .no-checkout { display: flex; flex-direction: column; gap: var(--sp-2); }
  .no-checkout-note { font-size: 0.6875rem; line-height: 1.45; color: var(--ink-3); }

  .blocked { font-size: var(--step--1); color: var(--sale); font-weight: 600; }

  .reassure { list-style: none; display: flex; flex-direction: column; gap: var(--sp-2); border-top: 1px solid var(--rule); padding-top: var(--sp-3); }
  .reassure li { font-size: var(--step--1); color: var(--ink-2); }

  .keep {
    color: var(--ink-2);
    text-align: center;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 860px) {
    .cart-grid { grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); }
    .summary { position: static; }
    .line { grid-template-columns: 72px minmax(0, 1fr); }
    .line-total { grid-column: 2; }
  }
</style>
