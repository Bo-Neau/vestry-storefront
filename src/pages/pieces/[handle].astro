---
/**
 * One piece.
 *
 * The storefront version of this page existed to sell: gallery, size picker,
 * price, sticky add-to-bag, reviews. None of that is here. What replaces it
 * is the credit — who designed it, who painted it, which collection it sits
 * in — because that is what the booklet actually documents and what the
 * client asked to lead with.
 *
 * The page ends on the designer rather than on a button. There is nothing to
 * buy, so the only honest next step is more of the work.
 */
import Base from "../../layouts/Base.astro";
import Photo from "../../components/Photo.astro";
import JsonLd from "../../components/JsonLd.astro";
import { designByHandle } from "../../data/designs.ts";
import { leadImage, supportingImages } from "../../data/journal.ts";
import { collectionOf, designsIn } from "../../data/collections.ts";
import { designerByName, workBy } from "../../data/people.ts";
import { BRAND, pageTitle } from "../../config/brand.ts";
import { designSchema, breadcrumbSchema } from "../../lib/seo/structured-data.ts";

/*
  Rendered on request rather than prerendered.

  Prerendered pages become static assets that the adapter serves directly,
  which means the middleware never runs for them — and the middleware is what
  sets the CSP, HSTS and frame headers. The site is thirteen pages of static
  data, so rendering them per request costs almost nothing and keeps every
  response behind those headers.
*/
const design = designByHandle(Astro.params.handle ?? "");
if (!design) return Astro.rewrite("/404");

const site = Astro.site ?? new URL("https://example.com");
const url = new URL(`/pieces/${design.handle}`, site).href;

const lead = leadImage(design);
const rest = supportingImages(design);
const collection = collectionOf(design.collection);
const designer = designerByName(design.designer);
const painter = design.artist ? designerByName(design.artist) : undefined;

// Other pieces in the same collection, so the page has somewhere to go.
const siblings = collection
  ? designsIn(collection).filter((d) => d.handle !== design.handle)
  : [];

// And other work by the same hand, which is the more interesting link.
const alsoBy = designer
  ? workBy(designer).filter((d) => d.handle !== design.handle).slice(0, 4)
  : [];

const trail = [
  { name: BRAND.name, url: site.href },
  ...(collection
    ? [{ name: collection.title, url: new URL(`/collections/${collection.handle}`, site).href }]
    : []),
  { name: design.title, url },
];
---

<Base
  title={pageTitle(`${design.title} — ${design.designer}`)}
  description={design.summary}
  ogImage={lead?.src}
  ogType="article"
>
  <JsonLd data={designSchema(design, url, site.href, BRAND.name)} />
  <JsonLd data={breadcrumbSchema(trail)} />

  <article class="piece">
    <div class="shell opening">
      {lead && (
        <div class="lead">
          <Photo photo={lead} sizes="(max-width: 900px) 100vw, 520px" priority />
        </div>
      )}

      <header class="masthead">
        {collection && (
          <a class="eyebrow" href={`/collections/${collection.handle}`}>{collection.title}</a>
        )}
        <h1>{design.title}</h1>
        <p class="summary">{design.summary}</p>

        <dl class="credits">
          <div>
            <dt>Designed by</dt>
            <dd>
              {designer
                ? <a href={`/designers/${designer.slug}`}>{design.designer}</a>
                : design.designer}
            </dd>
          </div>
          {design.artist && (
            <div>
              <dt>Painted by</dt>
              <dd>
                {painter
                  ? <a href={`/designers/${painter.slug}`}>{design.artist}</a>
                  : design.artist}
              </dd>
            </div>
          )}
          <div>
            <dt>Cloth</dt>
            <dd>{design.fabric}</dd>
          </div>
          <div>
            <dt>Shown in</dt>
            <dd>{design.colourName}</dd>
          </div>
        </dl>
      </header>
    </div>

    <div class="shell body">
      <div class="prose">
        <p>{design.description}</p>
      </div>

      {design.features.length > 0 && (
        <section class="notes" aria-labelledby="notes-h">
          <h2 id="notes-h" class="label">Notes on the making</h2>
          <ul>
            {design.features.map((f) => <li>{f}</li>)}
          </ul>
        </section>
      )}
    </div>

    {rest.length > 0 && (
      <section class="plates" aria-label={`More photographs of the ${design.title}`}>
        {rest.map((photo) => (
          <figure>
            <Photo photo={photo} sizes="(max-width: 900px) 100vw, 900px" />
            <figcaption>{photo.alt}</figcaption>
          </figure>
        ))}
      </section>
    )}

    {design.details.length > 0 && (
      <div class="shell">
        <section class="details" aria-labelledby="details-h">
          <h2 id="details-h" class="label">In short</h2>
          <ul>
            {design.details.map((d) => <li>{d}</li>)}
          </ul>
        </section>
      </div>
    )}
  </article>

  {alsoBy.length > 0 && designer && (
    <section class="shell onward" aria-labelledby="also-h">
      <h2 id="also-h">More by {designer.name}</h2>
      <ul class="strip">
        {alsoBy.map((d) => {
          const img = leadImage(d);
          return (
            <li>
              <a href={`/pieces/${d.handle}`}>
                {img && <Photo photo={img} sizes="(max-width: 700px) 45vw, 240px" alt="" />}
                <span class="strip-title">{d.title}</span>
                <span class="strip-meta">{d.collection}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {siblings.length > 0 && collection && (
    <section class="shell onward" aria-labelledby="rest-h">
      <h2 id="rest-h">The rest of {collection.title}</h2>
      <ul class="strip">
        {siblings.map((d) => {
          const img = leadImage(d);
          return (
            <li>
              <a href={`/pieces/${d.handle}`}>
                {img && <Photo photo={img} sizes="(max-width: 700px) 45vw, 240px" alt="" />}
                <span class="strip-title">{d.title}</span>
                <span class="strip-meta">{d.designer}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</Base>

<style>
  .piece { display: flex; flex-direction: column; }

  /*
    Photograph beside the credit, not above it.

    The garment shots are 2:3 cutouts — full width, the lead alone was 1350px
    tall and pushed the title, the designer and the whole reason for the page
    below the fold. Side by side, a reader sees the piece and who made it in
    the same glance, which is what this site is for.
  */
  .opening {
    display: grid;
    grid-template-columns: minmax(0, 520px) minmax(0, 1fr);
    gap: var(--sp-7);
    align-items: start;
    padding-block: var(--sp-6) var(--sp-7);
  }
  .lead { width: 100%; }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    padding-bottom: var(--sp-7);
    max-width: 720px;
  }

  .masthead { display: flex; flex-direction: column; gap: var(--sp-3); }

  a.eyebrow {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    align-self: flex-start;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  a.eyebrow:hover { color: var(--ink); }

  .masthead h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.1rem, 6vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .summary {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 46ch;
  }

  /* Credits sit above the prose, not below it. On this site the credit is
     the news; the description is the elaboration. */
  .credits {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin: 0;
  }
  .credits div { display: flex; flex-direction: column; gap: 4px; }
  .credits dt {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }
  .credits dd { margin: 0; font-size: var(--step-0); }
  /* 24px minimum target. These are standalone values in a definition list,
     not links inside prose, so the inline exception does not apply. */
  .credits a {
    text-underline-offset: 3px;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  .prose p {
    font-size: var(--step-1);
    line-height: 1.62;
    max-width: 62ch;
  }

  .notes ul, .details ul {
    list-style: none;
    padding: 0;
    margin: var(--sp-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .notes li, .details li {
    font-size: var(--step-0);
    color: var(--ink-2);
    padding-left: var(--sp-4);
    position: relative;
  }
  .notes li::before, .details li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 10px;
    height: 1px;
    background: var(--rule-2);
  }

  .details { padding-block: var(--sp-6); max-width: 720px; }

  /* Plates run full width of the reading column, stacked. An editorial page
     shows one photograph at a time; a grid here would read as a catalogue. */
  .plates {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    padding-inline: var(--sp-4);
  }
  .plates figure { margin: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
  .plates figcaption {
    font-size: var(--step--1);
    color: var(--ink-3);
    max-width: 54ch;
  }

  .onward {
    padding-block: var(--sp-7);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  .onward h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--step-2);
    letter-spacing: -0.015em;
  }
  .strip {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--sp-5) var(--sp-4);
  }
  .strip a {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    text-decoration: none;
  }
  .strip a:hover .strip-title { text-decoration: underline; text-underline-offset: 3px; }
  .strip-title { font-size: var(--step-0); }
  .strip-meta {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .opening {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-5);
    }
    /* Stacked, the photograph gets a ceiling so it cannot eat the screen. */
    .lead :global(img) { max-height: 68vh; width: auto; margin-inline: auto; }
  }

  @media (max-width: 700px) {
    .plates { padding-inline: 0; }
    .plates figcaption { padding-inline: var(--sp-4); }
    /*
      A 2:3 plate at full width is 1.08x the viewport on a phone, which puts
      its own caption off-screen. Capped so the photograph and the line that
      explains it are visible together.
    */
    .plates :global(img) {
      max-height: 80vh;
      width: auto;
      margin-inline: auto;
    }
  }
</style>
