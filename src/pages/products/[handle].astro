---
import Base from "../../layouts/Base.astro";
import Gallery from "../../components/Gallery.astro";
import SizeGuide from "../../components/SizeGuide.astro";
import Reviews from "../../components/Reviews.astro";
import ProductCard from "../../components/ProductCard.astro";
import JsonLd from "../../components/JsonLd.astro";
import { productSchema, breadcrumbSchema } from "../../lib/seo/structured-data.ts";
import { loadProduct, loadProducts, loadSizeChart } from "../../data/source.ts";
import { SIZE_ORDER, averageRating, fitVerdict } from "../../data/schema.ts";
import { formatMoney, discountPercent } from "../../lib/money.ts";
import { stockStateFor, stockLabel, LOW_STOCK_THRESHOLD } from "../../lib/stock.ts";
import { BRAND, COMMERCE, COPY, pageTitle } from "../../config/brand.ts";

const { handle } = Astro.params;
const { product } = handle ? await loadProduct(handle) : { product: undefined };

if (!product) {
  // Render the shared not-found page with a real 404, rather than a bare
  // status code the shopper sees as a blank screen.
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

/**
 * Add to bag posts to /cart/add, which mutates and redirects back (303).
 * A refresh therefore cannot re-add the item, and the whole flow needs no
 * JavaScript.
 *
 * Checkout itself is deliberately NOT built here: payment, tax, fraud and PCI
 * scope belong to the commerce platform.
 */
const addedSize = Astro.url.searchParams.get("added");
const addError = Astro.url.searchParams.get("error");

// Colourway lives in the query string: one canonical style URL, shareable
// variants, and no JavaScript needed to switch.
const requested = Astro.url.searchParams.get("color");
const colorway =
  product.colorways.find((c) => c.id === requested) ?? product.colorways[0]!;

const chart = await loadSizeChart(product.sizeChartId);
const avg = averageRating(product);
const { verdict } = fitVerdict(product);
const off = product.compareAtPrice
  ? discountPercent(product.price, product.compareAtPrice)
  : 0;

const heightFt = Math.floor(product.fit.modelHeightCm / 2.54 / 12);
const heightIn = Math.round((product.fit.modelHeightCm / 2.54) % 12);

const RUNS_NOTE: Record<typeof product.fit.runsTrueToSize, string> = {
  small: "Runs small — consider sizing up.",
  true: "Fits true to size.",
  large: "Runs large — consider sizing down.",
};

/**
 * Built from Astro.site, NOT Astro.url.
 *
 * Astro.url is the request URL, so basing the canonical on it makes every
 * host that serves the page canonicalise to itself — a preview deployment, a
 * proxy, or an apex/www variant would each claim to be canonical, which is
 * precisely what the tag exists to prevent.
 */
const siteBase = Astro.site ?? new URL("https://example.com");
const canonical = new URL(`/products/${product.handle}`, siteBase).href;

const siteOrigin = siteBase.origin;
const jsonLdProduct = productSchema(product, canonical, BRAND.name);
const jsonLdCrumbs = breadcrumbSchema([
  { name: "Home", url: `${siteOrigin}/` },
  { name: product.category, url: `${siteOrigin}/collections/${product.category.toLowerCase()}` },
  { name: product.title, url: canonical },
]);

const { products: allProducts } = await loadProducts();
const alsoLike = allProducts.filter(
  (p) => p.id !== product.id && p.category !== product.category,
).slice(0, 4);

const sizeRows = SIZE_ORDER.map((size) => {
  const state = stockStateFor(colorway, size);
  const row = colorway.sizes.find((s) => s.size === size);
  return { size, state, inventory: row ? row.inventory : 0 };
});
const anyInStock = sizeRows.some((r) => r.state !== "out");
---

<Base
  title={pageTitle(product.title, colorway.name)}
  description={product.summary}
  canonical={canonical}
  ogType="product"
>
  <Fragment slot="head">
    <JsonLd data={jsonLdProduct} />
    <JsonLd data={jsonLdCrumbs} />
  </Fragment>
  <div class="shell">
    <nav aria-label="Breadcrumb" class="crumbs">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <a href={`/collections/${product.category.toLowerCase()}`}>{product.category}</a>
      <span aria-hidden="true">/</span> <span>{product.title}</span>
    </nav>

    {addedSize && (
      <p class="added" role="status">
        Added to bag — {product.title}, {colorway.name}, size {addedSize}.
        <a href="/cart" class="added-link">View bag</a>
      </p>
    )}
    {addError && (
      <p class="add-error" role="alert">
        {addError === "size" ? "Choose a size before adding to your bag." : addError}
      </p>
    )}

    <div class="pdp">
      <!-- ZONE 1 — gallery -->
      <div class="pdp-media">
        <Gallery shape={product.shape} colorway={colorway} title={product.title} />
      </div>

      <div class="pdp-info">
        <!-- ZONE 2 — name, price, rating linked to reviews -->
        <header class="p-head">
          <h1>{product.title}</h1>
          {(product.designer || product.collection) && (
            <p class="credit">
              {product.designer && <span>Designer <strong>{product.designer}</strong></span>}
              {product.designer && product.collection && <span aria-hidden="true"> · </span>}
              {product.collection && <span>{product.collection}</span>}
            </p>
          )}
          <p class="p-price money">
            <span class={off > 0 ? "now" : ""}>{formatMoney(product.price)}</span>
            {product.compareAtPrice && (
              <>
                <s class="was">{formatMoney(product.compareAtPrice)}</s>
                <span class="off">{off}% off</span>
              </>
            )}
          </p>
          {product.reviews.length > 0 && (
            <p class="p-rating">
              <a href="#reviews">
                <span aria-hidden="true">{"★".repeat(Math.round(avg))}{"☆".repeat(5 - Math.round(avg))}</span>
                {" "}{avg.toFixed(1)}
                <span class="r-count"> ({product.reviews.length} reviews)</span>
              </a>
            </p>
          )}
          <p class="p-summary">{product.summary}</p>
          {product.artist && (
            <p class="artist-credit">Hand-painted by {product.artist}</p>
          )}
        </header>

        <!-- ZONE 3 — model reference. The single highest-value line here. -->
        <p class="fit-ref">
          Model is {heightFt}′{heightIn}″ ({product.fit.modelHeightCm}cm), wearing size {product.fit.modelSizeWorn}
        </p>
        <p class={`runs runs-${product.fit.runsTrueToSize}`}>
          {RUNS_NOTE[product.fit.runsTrueToSize]}
        </p>

        <form method="POST" action="/cart/add" class="buy" id="buy-form">
          <input type="hidden" name="handle" value={product.handle} />
          <input type="hidden" name="colorway" value={colorway.id} />
          <input type="hidden" name="quantity" value="1" />
          <input type="hidden" name="returnTo" value={`/products/${product.handle}?color=${colorway.id}`} />

          <!-- ZONE 4 — colourway: swatch AND name, never one alone -->
          <fieldset class="colors">
            <legend>
              <span class="label">Colour</span>
              <span class="c-name">{colorway.name}</span>
            </legend>
            <ul>
              {product.colorways.map((c) => (
                <li>
                  <a
                    href={`/products/${product.handle}?color=${c.id}`}
                    class:list={["sw", { on: c.id === colorway.id }]}
                    style={`--a: ${c.hex}; --b: ${c.hexAlt ?? c.hex};`}
                    aria-current={c.id === colorway.id ? "true" : undefined}
                  >
                    <span class="sr-only">{c.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </fieldset>

          <!-- ZONE 5 — sizes as BUTTONS, sold out struck through not hidden -->
          <fieldset class="sizes">
            <legend class="sz-legend">
              <span class="label">Size</span>
              {chart && <SizeGuide chart={chart} id={`sg-${product.handle}`} />}
            </legend>

            <ul class="sz-list">
              {sizeRows.map(({ size, state, inventory }) => (
                <li>
                  <input
                    type="radio"
                    name="size"
                    id={`sz-${size}`}
                    value={size}
                    disabled={state === "out"}
                    required
                    class="sz-input sr-only"
                  />
                  <label
                    for={`sz-${size}`}
                    class:list={["sz-btn", { out: state === "out" }]}
                  >
                    {size}
                    <span class="sr-only">
                      {" — "}{stockLabel(state)}
                      {state === "low" ? `, only ${inventory} left` : ""}
                    </span>
                  </label>
                </li>
              ))}
            </ul>

            {sizeRows.some((r) => r.state === "low") && (
              <p class="low-note">
                Low stock in {sizeRows.filter((r) => r.state === "low").map((r) => r.size).join(", ")}
                {" "}({LOW_STOCK_THRESHOLD} or fewer left in {colorway.name})
              </p>
            )}
            {!anyInStock && (
              <p class="low-note out-all">{colorway.name} is sold out in every size.</p>
            )}
          </fieldset>

          <!-- ZONE 6 — add to bag, sticky on mobile -->
          <div class="atc-wrap">
            <button type="submit" class="atc" disabled={!anyInStock}>
              {anyInStock ? "Add to bag" : "Sold out"}
            </button>
          </div>

          <!-- ZONE 7 — returns and shipping, inline with real numbers -->
          <ul class="policy">
            <li>{COPY.shippingTerms}</li>
            <li>{COPY.returnsTerms}</li>
            {COMMERCE.exchangesSupported && <li>{COPY.exchangeTerms}</li>}
          </ul>
        </form>

        <!-- ZONE 8 — specs, progressively disclosed -->
        <div class="specs">
          <details>
            <summary>Fit</summary>
            <div class="spec-body">
              <dl>
                <div><dt>Cut</dt><dd>{product.attributes.fit}</dd></div>
                {product.attributes.neckline && <div><dt>Neckline</dt><dd>{product.attributes.neckline}</dd></div>}
                {product.attributes.sleeveLength && <div><dt>Sleeve</dt><dd>{product.attributes.sleeveLength}</dd></div>}
                <div><dt>Cut for</dt><dd>{product.attributes.targetGender}</dd></div>
                <div><dt>Reviewers say</dt><dd>{verdict === "true" ? "True to size" : verdict === "small" ? "Runs small" : "Runs large"}</dd></div>
              </dl>
            </div>
          </details>

          <details>
            <summary>Materials &amp; care</summary>
            <div class="spec-body">
              <dl>
                <div><dt>Fabric</dt><dd>{product.attributes.fabric}</dd></div>
                <div><dt>Weight</dt><dd>{product.attributes.fabricWeightGsm} gsm</dd></div>
              </dl>
              <ul class="bullets">
                {product.care.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          </details>

          <details>
            <summary>Details</summary>
            <div class="spec-body">
              <ul class="bullets">
                {product.attributes.features.map((f) => <li>{f}</li>)}
                {product.details.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </details>

          <details>
            <summary>Description</summary>
            <div class="spec-body">
              <p class="desc">{product.description}</p>
            </div>
          </details>
        </div>
      </div>
    </div>

    <!--
      ZONE 6b — mobile add-to-bag bar.

      A sticky button inside the form only sticks while the form is on
      screen, so it disappears once the shopper reaches specs and reviews —
      exactly where they decide. A fixed bar with form="buy-form" submits the
      same form from outside it (valid HTML5), so the button is reachable at
      every scroll position without a line of JavaScript.
    -->
    <div class="atc-bar" aria-hidden="false">
      <span class="atc-bar-price money">{formatMoney(product.price)}</span>
      <button type="submit" form="buy-form" class="atc atc-bar-btn" disabled={!anyInStock}>
        {anyInStock ? "Add to bag" : "Sold out"}
      </button>
    </div>

    <!-- ZONE 9 — reviews with structured fit data -->
    <Reviews product={product} />

    <!-- ZONE 10 — outfit cross-sell, not a generic "related" grid -->
    <section class="look" aria-labelledby="look-title">
      <h2 id="look-title">Complete the look</h2>
      <ul class="grid">
        {alsoLike.map((p) => <li><ProductCard product={p} /></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: var(--sp-2);
    font-size: var(--step--1);
    color: var(--ink-3);
    padding-block: var(--sp-5) var(--sp-4);
    flex-wrap: wrap;
  }
  .crumbs a { color: var(--ink-2); display: inline-block; padding-block: var(--sp-2); }

  .added {
    background: var(--paper-3);
    border-left: 3px solid var(--in-stock);
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-4);
    font-size: var(--step--1);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .added-link {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent);
    align-self: flex-start;
  }
  .add-error {
    background: var(--paper-3);
    border-left: 3px solid var(--sale);
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-4);
    font-size: var(--step--1);
    color: var(--sale);
    font-weight: 600;
  }

  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 420px);
    gap: var(--sp-8);
    align-items: start;
    padding-bottom: var(--sp-8);
  }
  .pdp-info {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    position: sticky;
    top: 88px;
  }

  .p-head { display: flex; flex-direction: column; gap: var(--sp-2); }
  .p-head h1 { font-size: var(--step-3); line-height: 1.08; }
  .p-price { display: flex; gap: var(--sp-3); align-items: baseline; font-size: var(--step-1); }
  .p-price .now { color: var(--sale); }
  .was { color: var(--ink-3); font-size: var(--step-0); }
  .off {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sale);
  }
  .p-rating a {
    font-size: var(--step--1); color: var(--ink-2); letter-spacing: 0.06em;
    display: inline-flex; align-items: center; min-height: 44px;
  }
  .r-count { color: var(--ink-3); letter-spacing: 0; }
  .p-summary { color: var(--ink-2); }
  .credit {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-3);
  }
  .credit strong { color: var(--ink-2); font-weight: 500; }
  /* The painter is credited separately from the designer — for this house
     they are usually different people, and the booklet names both. */
  .artist-credit {
    font-size: var(--step--1);
    font-style: italic;
    color: var(--ink-2);
  }

  /* Zone 3 — deliberately prominent */
  .fit-ref {
    font-size: var(--step-0);
    font-weight: 600;
    padding: var(--sp-3) var(--sp-4);
    background: var(--paper-3);
    border-radius: var(--radius);
  }
  .runs { font-size: var(--step--1); }
  .runs-true { color: var(--in-stock); }
  .runs-small, .runs-large { color: var(--low-stock); font-weight: 600; }

  .buy { display: flex; flex-direction: column; gap: var(--sp-5); }
  fieldset { border: none; padding: 0; margin: 0; }
  legend { padding: 0; margin-bottom: var(--sp-3); width: 100%; }

  .colors legend { display: flex; gap: var(--sp-3); align-items: baseline; }
  .c-name { font-size: var(--step--1); }
  .colors ul { list-style: none; display: flex; gap: var(--sp-3); flex-wrap: wrap; }
  .sw {
    display: block;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--a) 0 52%, var(--b) 52% 100%);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.2);
    outline-offset: 3px;
  }
  .sw.on { box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.2), 0 0 0 1.5px var(--ink); }

  .sz-legend { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-3); }
  .sz-list { list-style: none; display: flex; gap: var(--sp-2); flex-wrap: wrap; }
  .sz-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    min-height: 44px;               /* 44px touch target */
    padding: 0 var(--sp-3);
    border: 1px solid var(--rule-2);
    font-family: var(--mono);
    font-size: var(--step--1);
    cursor: pointer;
    background: var(--paper-2);
    user-select: none;
  }
  .sz-btn:hover { border-color: var(--ink); }
  .sz-input:checked + .sz-btn {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .sz-input:focus-visible + .sz-btn { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Sold out stays visible and struck through — absence made legible. */
  .sz-btn.out {
    color: var(--out-stock);
    border-color: var(--rule);
    text-decoration: line-through;
    cursor: not-allowed;
    background: transparent;
  }
  .sz-btn.out:hover { border-color: var(--rule); }

  .low-note { font-size: var(--step--1); color: var(--low-stock); margin-top: var(--sp-3); }
  .out-all { color: var(--out-stock); }
  .err { font-size: var(--step--1); color: var(--sale); font-weight: 600; margin-bottom: var(--sp-3); }

  .atc {
    width: 100%;
    background: var(--ink);
    color: var(--paper);
    border: none;
    padding: var(--sp-4);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    min-height: 52px;
  }
  .atc:hover:not(:disabled) { opacity: 0.88; }
  .atc:disabled { background: var(--out-stock); cursor: not-allowed; }

  .policy { list-style: none; display: flex; flex-direction: column; gap: var(--sp-2); }
  .policy li { font-size: var(--step--1); color: var(--ink-2); padding-left: var(--sp-4); position: relative; }
  .policy li::before { content: "—"; position: absolute; left: 0; color: var(--ink-3); }

  .specs { display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
  .specs details { border-bottom: 1px solid var(--rule); }
  .specs summary {
    cursor: pointer;
    padding: var(--sp-4) 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    list-style-position: inside;
  }
  .specs summary:hover { color: var(--ink); }
  .spec-body { padding-bottom: var(--sp-4); display: flex; flex-direction: column; gap: var(--sp-3); }
  .spec-body dl { display: flex; flex-direction: column; gap: var(--sp-2); }
  .spec-body dl > div { display: grid; grid-template-columns: 108px minmax(0, 1fr); gap: var(--sp-3); }
  .spec-body dt {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-3);
    padding-top: 3px;
  }
  .spec-body dd { margin: 0; font-size: var(--step--1); }
  .bullets { list-style: none; display: flex; flex-direction: column; gap: var(--sp-2); }
  .bullets li { font-size: var(--step--1); color: var(--ink-2); padding-left: var(--sp-4); position: relative; }
  .bullets li::before { content: "·"; position: absolute; left: 5px; color: var(--ink-3); }
  .desc { font-size: var(--step--1); color: var(--ink-2); max-width: 62ch; }

  .look { padding-block: var(--sp-8) 0; display: flex; flex-direction: column; gap: var(--sp-5); }
  .look h2 { font-size: var(--step-2); }
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--sp-6) var(--sp-5);
  }

  /* Desktop: the inline button is enough, the bar is not needed. */
  .atc-bar { display: none; }

  @media (max-width: 960px) {
    .pdp { grid-template-columns: minmax(0, 1fr); gap: var(--sp-6); }
    .pdp-info { position: static; }

    /* On mobile the fixed bar replaces the inline button entirely, so there
       is only ever one add-to-bag control on screen. */
    .atc-wrap { display: none; }

    .atc-bar {
      display: flex;
      align-items: center;
      gap: var(--sp-3);
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 30;
      background: var(--paper);
      border-top: 1px solid var(--rule);
      padding: var(--sp-3) var(--sp-4);
      padding-bottom: max(var(--sp-3), env(safe-area-inset-bottom));
    }
    .atc-bar-price { font-size: var(--step-1); flex: 0 0 auto; }
    .atc-bar-btn { flex: 1 1 auto; width: auto; }

    /* Reserve room so the fixed bar never sits over footer content.
       Scoped to this page's stylesheet, which only loads on product pages. */
    :global(body) { padding-bottom: 88px; }

    .grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: var(--sp-5) var(--sp-3); }
  }
</style>
