---
/**
 * The people.
 *
 * Manussa is a collective, so this page is closer to a masthead than to a
 * team page. Each person is listed with the work they are credited on, since
 * the work is the only thing I actually know about them — the bios are the
 * client's to write and the page is built to gain them later.
 */
import Base from "../../layouts/Base.astro";
import Photo from "../../components/Photo.astro";
import JsonLd from "../../components/JsonLd.astro";
import { CREDITED, workBy, designedBy, paintedBy } from "../../data/people.ts";
import { leadImage } from "../../data/journal.ts";
import { BRAND, pageTitle } from "../../config/brand.ts";
import { breadcrumbSchema } from "../../lib/seo/structured-data.ts";

const site = Astro.site ?? new URL("https://example.com");

const people = CREDITED.map((designer) => {
  const work = workBy(designer);
  const cut = designedBy(designer).length;
  const painted = paintedBy(designer).length;
  return {
    designer,
    work,
    lead: work[0] ? leadImage(work[0]) : undefined,
    // Say what they did, not just how many. On the painted pieces the
    // designer and the painter are different people.
    credit: [
      cut > 0 ? `${cut} ${cut === 1 ? "piece" : "pieces"} designed` : null,
      painted > 0 ? `${painted} painted` : null,
    ].filter(Boolean).join(" · "),
  };
});

const trail = [
  { name: BRAND.name, url: site.href },
  { name: "Designers", url: new URL("/designers", site).href },
];
---

<Base
  title={pageTitle("Designers")}
  description={`The designers and painters credited in the collections of ${BRAND.name}.`}
>
  <JsonLd data={breadcrumbSchema(trail)} />

  <div class="shell head">
    <p class="label">The house</p>
    <h1>Designers</h1>
    <p class="standfirst">
      Manussa is a collective. Every piece carries the name of the person who
      cut it, and where a garment was painted, the name of the painter as well.
    </p>
  </div>

  <ul class="people">
    {people.map(({ designer, work, lead, credit }, i) => (
      <li class="person">
        <a href={`/designers/${designer.slug}`} class="person-link">
          {lead && (
            <div class="person-media">
              <Photo photo={lead} sizes="(max-width: 640px) 96px, 200px" priority={i === 0} alt="" />
            </div>
          )}
          <div class="person-body">
            <h2>{designer.name}</h2>
            {designer.role && <p class="role">{designer.role}</p>}
            <p class="credit">{credit}</p>
            <p class="titles">{work.map((d) => d.title).join(", ")}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .head {
    padding-block: var(--sp-7) var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .head h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .standfirst { font-size: var(--step-1); color: var(--ink-2); max-width: 52ch; line-height: 1.5; }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .person { border-top: 1px solid var(--rule); }
  .person:last-child { border-bottom: 1px solid var(--rule); }

  .person-link {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--sp-5);
    align-items: center;
    padding: var(--sp-4);
    max-width: 1000px;
    margin: 0 auto;
    text-decoration: none;
  }
  .person-media { overflow: hidden; }
  .person-media :global(img) { aspect-ratio: 1 / 1; object-fit: cover; }

  .person-body { display: flex; flex-direction: column; gap: var(--sp-2); }
  .person-body h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .person-link:hover h2 { text-decoration: underline; text-underline-offset: 4px; }
  .role, .credit {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }
  .titles { font-size: var(--step-0); color: var(--ink-2); max-width: 56ch; }

  @media (max-width: 640px) {
    .person-link { grid-template-columns: 96px minmax(0, 1fr); gap: var(--sp-4); }
  }
</style>
