---
/**
 * The front of the journal.
 *
 * Not a shop window and not a feed. The order is: what the house is, the
 * collections as issues, the pieces, the people who made them. Nothing on
 * this page carries a date, so nothing on it can go stale — which is the
 * whole reason for building it as a publication rather than a blog.
 */
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import JsonLd from "../components/JsonLd.astro";
import { COLLECTIONS, designsIn } from "../data/collections.ts";
import { DESIGNS, designByHandle } from "../data/designs.ts";
import { CREDITED, workBy } from "../data/people.ts";
import { leadImage } from "../data/journal.ts";
import { BRAND, pageTitle } from "../config/brand.ts";
import { organisationSchema, websiteSchema } from "../lib/seo/structured-data.ts";

const site = Astro.site ?? new URL("https://example.com");

const hero = {
  src: "/photography/collection-lineup.jpg",
  alt: "Pieces from the Hope Collection shown together in the atelier",
  width: 2000,
  height: 1333,
  view: "front" as const,
};

const issues = COLLECTIONS.map((collection) => {
  const lead = designByHandle(collection.lead);
  return { collection, photo: lead ? leadImage(lead) : undefined, count: designsIn(collection).length };
});

// The pieces that carry more than one photograph — they have the most to
// look at, which is the only thing worth optimising for on an editorial front.
const featured = DESIGNS.filter((d) => d.images.length > 1).slice(0, 4);
---

<Base
  title={pageTitle(BRAND.tagline)}
  description={BRAND.intro}
  ogImage={hero.src}
>
  <JsonLd data={organisationSchema(site.href, BRAND.name)} />
  <JsonLd data={websiteSchema(site.href, BRAND.name)} />

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media">
      <Photo photo={hero} sizes="100vw" priority alt="" />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-copy shell">
      <p class="hero-eyebrow">{BRAND.legalName} <span aria-hidden="true">·</span> Yangon</p>
      <h1 id="hero-title">{BRAND.tagline}</h1>
      <p class="hero-lede">{BRAND.intro}</p>
      <a href="/collections" class="hero-cta">Read the collections</a>
    </div>
  </section>

  <section class="shell statement" aria-labelledby="statement-h">
    <h2 id="statement-h">
      Every piece is credited to the person who made it.
    </h2>
    <p>
      Manussa is a collective, not a single hand. Seven people are named across
      six collections &mdash; the designers who cut the cloth, and the painter
      who works on it afterwards. The credits are the point, so they are on
      every page rather than buried in an about section.
    </p>
    <a href="/designers" class="statement-link">Meet the designers</a>
  </section>

  <section class="issues-sec" aria-labelledby="issues-h">
    <div class="shell sec-head">
      <p class="label">The collections</p>
      <h2 id="issues-h">Six bodies of work</h2>
    </div>
    <ul class="issues">
      {issues.map(({ collection, photo, count }) => (
        <li>
          <a href={`/collections/${collection.handle}`}>
            {photo && (
              <div class="issue-media">
                <Photo photo={photo} sizes="(max-width: 700px) 46vw, 260px" alt="" />
              </div>
            )}
            <span class="issue-no">{collection.eyebrow}</span>
            <span class="issue-title">{collection.title}</span>
            <span class="issue-stand">{collection.standfirst}</span>
            <span class="issue-count">{count} {count === 1 ? "piece" : "pieces"}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="featured-sec" aria-labelledby="featured-h">
    <div class="shell sec-head">
      <p class="label">Selected</p>
      <h2 id="featured-h">Pieces photographed from more than one side</h2>
    </div>
    <ul class="featured">
      {featured.map((design) => {
        const photo = leadImage(design);
        return (
          <li>
            <a href={`/pieces/${design.handle}`}>
              {photo && (
                <div class="feat-media">
                  <Photo photo={photo} sizes="(max-width: 700px) 84vw, 380px" alt="" />
                </div>
              )}
              <span class="feat-title">{design.title}</span>
              <span class="feat-meta">{design.designer}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="shell people-sec" aria-labelledby="people-h">
    <p class="label">The house</p>
    <h2 id="people-h">Seven names</h2>
    <ul class="names">
      {CREDITED.map((p) => (
        <li>
          <a href={`/designers/${p.slug}`}>
            <span class="n">{p.name}</span>
            <span class="c">{workBy(p).length} {workBy(p).length === 1 ? "piece" : "pieces"}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    position: relative;
    min-height: min(84vh, 780px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    /*
      The colour the photograph lies on, and what shows if it fails to load.
      A fixed literal, not var(--ink) — the copy over it is always white, and
      --ink inverts to near-white in dark mode.
    */
    background: #14130F;
  }
  /*
    A wrapper, not a class on the image.

    Astro's <Picture> forwards `class` to the inner <img>, not to the <picture>
    element — so positioning the class absolutely put `inset: 0` on an image
    that still had `height: auto`, and the hero photograph rendered 250px tall
    inside a 633px hero. Styling through a wrapper works wherever the class
    happens to land.
  */
  .hero-media { position: absolute; inset: 0; }
  .hero-media :global(picture) { display: block; width: 100%; height: 100%; }
  .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /*
    Two layers. The vertical gradient alone had to be crushingly dark to beat
    the pale garments the headline crosses; a left-side wash lets the copy
    column go dark while the right of the frame keeps its depth.
  */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgb(10 9 7 / 0.80) 0%, rgb(10 9 7 / 0.40) 46%, rgb(10 9 7 / 0) 78%),
      linear-gradient(to top, rgb(10 9 7 / 0.94) 0%, rgb(10 9 7 / 0.82) 36%, rgb(10 9 7 / 0.46) 66%, rgb(10 9 7 / 0.14) 100%);
  }
  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding-block: var(--sp-7);
    max-width: 720px;
  }
  /* Opaque, not translucent. White at 72% cannot reach contrast over a
     photograph however dark the scrim gets. */
  .hero-eyebrow {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #FFFFFF;
  }
  .hero h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.6rem, 9vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: #FFFFFF;
  }
  .hero-lede {
    font-size: var(--step-1);
    line-height: 1.5;
    color: #FFFFFF;
    max-width: 48ch;
  }
  .hero-cta {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #FFFFFF;
    border: 1px solid rgb(255 255 255 / 0.55);
    padding: 0 var(--sp-5);
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .hero-cta:hover { border-color: #FFFFFF; background: rgb(255 255 255 / 0.08); }

  /* ---------------- statement ---------------- */
  .statement {
    padding-block: var(--sp-7);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    max-width: 720px;
  }
  .statement h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.8rem, 4.6vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .statement p { font-size: var(--step-1); line-height: 1.6; color: var(--ink-2); max-width: 60ch; }
  .statement-link, .sec-head + * { /* keeps the cascade explicit */ }
  .statement-link {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  /* ---------------- shared section heads ---------------- */
  .sec-head { display: flex; flex-direction: column; gap: var(--sp-2); padding-bottom: var(--sp-5); }
  .sec-head h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* ---------------- issues ---------------- */
  .issues-sec { padding-block: var(--sp-6) var(--sp-7); border-top: 1px solid var(--rule); }
  .issues {
    list-style: none;
    margin: 0 auto;
    padding: 0 var(--sp-4);
    max-width: 1200px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--sp-6) var(--sp-4);
  }
  .issues a { display: flex; flex-direction: column; gap: var(--sp-2); text-decoration: none; }
  .issue-media { overflow: hidden; margin-bottom: var(--sp-1); }
  .issue-media :global(img) { aspect-ratio: 4 / 5; object-fit: cover; }
  .issue-no {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }
  .issue-title { font-family: var(--display); font-size: var(--step-1); line-height: 1.15; }
  .issues a:hover .issue-title { text-decoration: underline; text-underline-offset: 3px; }
  .issue-stand { font-size: var(--step--1); color: var(--ink-2); }
  .issue-count {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  /* ---------------- featured ---------------- */
  .featured-sec { padding-block: var(--sp-6) var(--sp-7); border-top: 1px solid var(--rule); }
  .featured {
    list-style: none;
    margin: 0;
    padding: 0 var(--sp-4);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 380px);
    gap: var(--sp-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .featured::-webkit-scrollbar { display: none; }
  .featured li { scroll-snap-align: start; }
  .featured a { display: flex; flex-direction: column; gap: var(--sp-2); text-decoration: none; }
  .feat-media { overflow: hidden; }
  .feat-media :global(img) { aspect-ratio: 4 / 5; object-fit: cover; }
  .feat-title { font-family: var(--display); font-size: var(--step-1); }
  .featured a:hover .feat-title { text-decoration: underline; text-underline-offset: 3px; }
  .feat-meta {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  /* ---------------- people ---------------- */
  .people-sec {
    padding-block: var(--sp-6) var(--sp-7);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .people-sec h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    letter-spacing: -0.02em;
    padding-bottom: var(--sp-4);
  }
  .names { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .names li { border-top: 1px solid var(--rule); }
  .names li:last-child { border-bottom: 1px solid var(--rule); }
  .names a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
    min-height: 48px;
    text-decoration: none;
  }
  .names .n { font-family: var(--display); font-size: var(--step-2); }
  .names a:hover .n { text-decoration: underline; text-underline-offset: 4px; }
  .names .c {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .hero { min-height: min(78vh, 640px); }
    .hero-scrim {
      background: linear-gradient(
        to top,
        rgb(10 9 7 / 0.93) 0%,
        rgb(10 9 7 / 0.84) 46%,
        rgb(10 9 7 / 0.52) 74%,
        rgb(10 9 7 / 0.16) 100%
      );
    }
  }
</style>
