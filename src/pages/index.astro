---
/**
 * Manussa.
 *
 * One scrolling document, as the brief specifies. Every string comes from
 * src/data/site.ts, which is a transcription of that brief.
 *
 * Two structural decisions worth stating, because both depart from the
 * obvious reading:
 *
 * 1. The collections are not numbered 01–05. Each is labelled with the
 *    painting it came from — "The Hell", "Red Strings", "Hidden Layers" —
 *    because that is the organising fact of this house; the two collections
 *    with no painting are labelled with their material instead. A numeral
 *    would say only "there are five of these".
 *
 * 2. The photograph in each collection pins while its text passes. That is
 *    the scroll doing editorial work: a buyer looks at one garment for as
 *    long as it takes to read about it, rather than scrolling past a row.
 *
 * No JavaScript. The menu is a <details>, the motion is CSS scroll timelines.
 */
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Drip from "../components/Drip.astro";
import JsonLd from "../components/JsonLd.astro";
import { Image } from "astro:assets";
import lockupLight from "../assets/brand/lockup-light.png";
import monogramLight from "../assets/brand/monogram-light.png";
import {
  BRAND, TEXWORLD, NAV, HERO, MANIFESTO, COLLECTIONS,
  ART, TECHNIQUES, HOUSE, VISIT, SOCIAL, FOOTER,
} from "../data/site.ts";

const site = Astro.site ?? new URL("https://manussa.example");

/* The painting, or the material where there is none. Derived from the credits
   rather than authored separately, so the label can never disagree with the
   lines underneath it. */
const originOf = (credit: readonly string[]): string => {
  const painting = credit.find((c) => c.startsWith("Inspired by"));
  if (painting) return painting.replace("Inspired by ", "").split(" · ")[0]!;
  return credit[0]!;
};

const organisation = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: BRAND.name,
  description: BRAND.description,
  url: site.href,
  parentOrganization: { "@type": "Organization", name: BRAND.parent },
  address: { "@type": "PostalAddress", addressLocality: "Yangon", addressCountry: "MM" },
  email: BRAND.email,
  slogan: BRAND.tagline,
};

const event = {
  "@context": "https://schema.org",
  "@type": "ExhibitionEvent",
  name: `${BRAND.name} at ${TEXWORLD.event}`,
  startDate: TEXWORLD.start,
  endDate: TEXWORLD.end,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: `${TEXWORLD.event} — ${TEXWORLD.hall}, ${TEXWORLD.booth}`,
    address: { "@type": "PostalAddress", addressLocality: "Paris", addressCountry: "FR" },
  },
  organizer: { "@type": "Organization", name: BRAND.name, url: site.href },
};
---

<Base
  title={`${BRAND.name} — ${BRAND.tagline}`}
  description={BRAND.description}
  ogImage={HERO.image}
>
  <JsonLd data={organisation} slot="head" />
  <JsonLd data={event} slot="head" />

  <!-- ============================= header ============================= -->
  <header class="head" slot="header">
    <div class="shell head-inner">
      <a href="#top" class="brand" aria-label={`${BRAND.name} — top of page`}>
        <Image src={monogramLight} alt="" width={26} height={25} densities={[1, 2]} />
        <span class="brand-word">{BRAND.name}</span>
      </a>

      <nav class="nav" aria-label="Sections">
        <ul>{NAV.map((i) => <li><a class="link-draw" href={i.href}>{i.label}</a></li>)}</ul>
      </nav>

      <a class="head-mail link-draw" href={`mailto:${BRAND.email}`}>Contact</a>

      <details class="menu">
        <summary aria-label="Menu"><span class="menu-rule" aria-hidden="true"></span>Menu</summary>
        <ul class="menu-panel">
          {NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href={`mailto:${BRAND.email}`}>Contact</a></li>
        </ul>
      </details>
    </div>
  </header>

  <!-- ============================== hero ============================== -->
  <section class="hero" id="top" aria-labelledby="hero-h">
    <div class="hero-frame">
      <div class="hero-media parallax-slow">
        <Photo src={HERO.image} alt="" sizes="100vw" priority />
      </div>
    </div>
    <div class="hero-veil" aria-hidden="true"></div>

    <div class="shell hero-copy">
      <p class="hero-eyebrow">{HERO.eyebrow}</p>
      <h1 id="hero-h" class="hero-mark">
        <Image src={lockupLight} alt={BRAND.name} widths={[480, 720, 960]}
               sizes="(max-width: 760px) 82vw, 560px" loading="eager" />
      </h1>
      <p class="hero-line">{HERO.tagline}</p>
      <div class="hero-acts">
        <a class="btn btn-fill" href={HERO.primary.href}>{HERO.primary.label}</a>
        <a class="btn btn-line" href={HERO.secondary.href}>{HERO.secondary.label}</a>
      </div>
    </div>

    <!--
      The ink section below reaches up into the photograph with a painted
      edge. Static: this one marks a boundary, and strokes that travel would
      cross the buttons.
    -->
    <div class="hero-drip" aria-hidden="true"><Drip height={104} /></div>
  </section>

  <!-- ============================ manifesto =========================== -->
  <section class="manifesto" aria-labelledby="manifesto-h">
    <div class="shell manifesto-grid">
      <div class="manifesto-copy stagger">
        <p class="label">From painting to clothes</p>
        <h2 id="manifesto-h">{MANIFESTO.heading}</h2>
        <p class="lead">{MANIFESTO.lead}</p>
        <p class="prose">{MANIFESTO.body}</p>
      </div>

      <figure class="manifesto-plate rise">
        <div class="plate-frame">
          <div class="parallax-mid">
            <Photo src={MANIFESTO.image} alt={MANIFESTO.imageAlt}
                   sizes="(max-width: 980px) 92vw, 540px" />
          </div>
        </div>
      </figure>
    </div>

    <div class="shell">
      <ul class="techniques stagger" aria-label="Techniques">
        {TECHNIQUES.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- =========================== collections ========================== -->
  <section class="collections" id="collections" aria-labelledby="collections-h">
    <div class="shell coll-head">
      <p class="label">2026 &mdash; {BRAND.concept}</p>
      <h2 id="collections-h">The Collections</h2>
      <span class="rule draw" aria-hidden="true"></span>
      <p class="coll-intro">
        Five collections, each born from a painting &mdash; limited-edition art
        pieces and everyday ready-to-wear, all made to be worn.
      </p>
    </div>

    {COLLECTIONS.map((c, i) => (
      <article class="coll" id={c.handle} data-side={i % 2 === 0 ? "left" : "right"}>
        <div class="shell coll-grid">
          <div class="coll-visual">
            <div class="coll-sticky">
              <div class="coll-frame">
                <div class="parallax-slow">
                  <Photo src={c.image} alt={c.imageAlt}
                         sizes="(max-width: 980px) 92vw, 560px" />
                </div>
              </div>
              {c.detail && (
                <figure class="coll-inset parallax-counter">
                  <Photo src={c.detail} alt={c.detailAlt ?? ""}
                         sizes="(max-width: 980px) 44vw, 210px" />
                </figure>
              )}
            </div>
          </div>

          <div class="coll-text">
            <p class="coll-origin">{originOf(c.credit)}</p>
            <h3 class="coll-name">{c.name}</h3>
            <p class="coll-line">{c.tagline}</p>
            <p class="coll-body">{c.body}</p>
            <ul class="coll-credit">
              {c.credit.map((line) => <li>{line}</li>)}
            </ul>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- ============================== art =============================== -->
  <section class="art" id="artists" aria-labelledby="art-h">
    <div class="art-drip" aria-hidden="true"><Drip height={128} class="parallax-fall" /></div>

    <div class="shell art-grid">
      <div class="art-copy">
        <p class="label">{ART.eyebrow}</p>
        <h2 id="art-h">{ART.heading}</h2>
        <p class="art-body">{ART.body}</p>
        <ul class="art-names">
          {ART.names.map((n) => <li>{n}</li>)}
        </ul>
      </div>
      <div class="art-plates">
        {ART.images.map((img, n) => (
          <figure class={n === 1 ? "art-plate art-plate-low" : "art-plate"}>
            <div class="plate-frame">
              <div class="parallax-mid">
                <Photo src={img.src} alt={img.alt} sizes="(max-width: 980px) 88vw, 360px" />
              </div>
            </div>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================= house ============================== -->
  <section class="house" id="house" aria-labelledby="house-h">
    <div class="shell house-inner">
      <div class="house-head">
        <p class="label">The House</p>
        <h2 id="house-h">{HOUSE.heading}</h2>
        <p class="house-intro">{HOUSE.intro}</p>
      </div>

      <ul class="founders stagger">
        {HOUSE.founders.map((f) => (
          <li class="founder">
            <span class="founder-rule" aria-hidden="true"></span>
            <h3 class="founder-name">{f.name}</h3>
            <p class="founder-role">{f.role}</p>
            <p class="founder-body">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================= visit ============================== -->
  <section class="visit" id="visit" aria-labelledby="visit-h">
    <div class="visit-frame">
      <div class="visit-media parallax-slow">
        <Photo src={VISIT.image} alt="" sizes="100vw" />
      </div>
    </div>
    <div class="visit-veil" aria-hidden="true"></div>

    <div class="shell visit-copy">
      <p class="label">{VISIT.eyebrow}</p>
      <h2 id="visit-h">{VISIT.heading}</h2>
      <p class="visit-body">{VISIT.body}</p>

      <dl class="stand">
        <div><dt>Hall</dt><dd>{TEXWORLD.hall.replace("Hall ", "")}</dd></div>
        <div><dt>Booth</dt><dd>{TEXWORLD.booth.replace("Booth ", "")}</dd></div>
        <div class="stand-when">
          <dt>Dates</dt>
          <dd><time datetime={TEXWORLD.start}>{TEXWORLD.datesLong}</time></dd>
        </div>
      </dl>

      <a class="btn btn-fill" href={VISIT.cta.href}>{VISIT.cta.label}</a>
    </div>
  </section>

  <!-- ============================= footer ============================= -->
  <footer class="foot" slot="footer">
    <div class="shell foot-inner">
      <div class="foot-brand">
        <Image src={monogramLight} alt="" width={34} height={33} densities={[1, 2]} class="foot-mark" />
        <p class="foot-blurb">{BRAND.blurb}</p>
        {SOCIAL.length > 0 && (
          <ul class="foot-social">{SOCIAL.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
        )}
      </div>

      <nav class="foot-col" aria-label="Explore">
        <p class="foot-label">Explore</p>
        <ul>{FOOTER.explore.map((l) => <li><a class="link-draw" href={l.href}>{l.label}</a></li>)}</ul>
      </nav>

      <div class="foot-col">
        <p class="foot-label">Contact</p>
        <ul>
          <li><a href={`mailto:${BRAND.email}`}>{BRAND.email}</a></li>
          <li><a href={BRAND.websiteUrl} rel="noopener">{BRAND.website}</a></li>
          <li><span class="foot-static">{BRAND.city}</span></li>
          <li><span class="foot-static">{TEXWORLD.event}, {TEXWORLD.hall}, {TEXWORLD.booth}</span></li>
        </ul>
      </div>

      <p class="foot-legal">{FOOTER.legal}</p>
    </div>
  </footer>
</Base>

<style>
  /* ================================ header ============================== */
  .head {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--ink-deep);
    border-bottom: 1px solid var(--hair);
  }
  .head-inner { display: flex; align-items: center; gap: var(--sp-6); min-height: 66px; }

  .brand { display: inline-flex; align-items: center; gap: var(--sp-3); margin-right: auto; }
  .brand:hover { text-decoration: none; }
  .brand :global(img) { width: 22px; height: auto; }
  .brand-word {
    font-family: var(--display);
    font-size: var(--step-2);
    text-transform: uppercase;
    letter-spacing: 0.36em;
    margin-right: -0.36em;   /* uppercase tracking leaves a trailing gap */
    color: var(--cream);
  }

  .nav ul { display: flex; gap: var(--sp-6); }
  .nav a, .head-mail {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-nav);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .nav a { color: var(--ash); }
  .nav a:hover { color: var(--cream); }
  .head-mail { color: var(--gold); }
  .head-mail:hover { color: var(--cream); }

  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 44px;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-nav);
    color: var(--cream);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-rule { width: 20px; height: 1px; background: currentColor; box-shadow: 0 5px 0 currentColor; }
  .menu[open] .menu-rule { box-shadow: none; }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    min-width: 230px;
    background: var(--ink-lift);
    border: 1px solid var(--hair-firm);
    padding: var(--sp-2);
  }
  .menu-panel a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: var(--sp-4);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--cream);
  }
  .menu-panel a:hover { background: rgb(247 244 238 / 0.06); text-decoration: none; }

  @media (max-width: 980px) {
    .nav, .head-mail { display: none; }
    .menu { display: block; }
    .brand-word { font-size: var(--step-1); letter-spacing: 0.3em; margin-right: -0.3em; }
  }

  /* ================================= hero =============================== */
  .hero {
    position: relative;
    min-height: min(94vh, 940px);
    display: flex;
    align-items: flex-end;
    background: var(--ink-deep);
    overflow: hidden;
  }
  /*
    The frame clips; the layer inside is oversized and drifts within it.
    Without the extra height the parallax would expose an edge at one end of
    its travel.
  */
  .hero-frame { position: absolute; inset: 0; overflow: hidden; }
  .hero-media { position: absolute; inset: -12% 0; }
  .hero-media :global(picture), .hero-media :global(img) { width: 100%; height: 100%; }
  .hero-media :global(img) { object-fit: cover; object-position: 50% 40%; }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgb(11 10 9 / 0.82) 0%, rgb(11 10 9 / 0.44) 46%, rgb(11 10 9 / 0) 78%),
      linear-gradient(to top, rgb(11 10 9 / 0.92) 0%, rgb(11 10 9 / 0.60) 32%, rgb(11 10 9 / 0.20) 66%, rgb(11 10 9 / 0.08) 100%);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-5);
    padding-block: var(--sp-10) var(--sp-9);
  }
  /* Opaque cream. Translucent white cannot reach contrast over a photograph
     however dark the veil is. */
  .hero-eyebrow {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--cream);
  }
  .hero-mark { line-height: 0; }
  .hero-mark :global(img) { width: min(560px, 82vw); height: auto; }
  .hero-line {
    font-family: var(--display);
    font-style: italic;
    font-weight: var(--display-weight);
    font-size: var(--step-4);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--cream);
  }
  .hero-acts { display: flex; flex-wrap: wrap; gap: var(--sp-4); margin-top: var(--sp-2); }

  /* Sits under the copy, not over it. */
  .hero-drip {
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    z-index: 1;
    color: var(--ink);
    pointer-events: none;
    transform: scaleY(-1);   /* strokes rise from the ink block into the frame */
  }

  /* =============================== buttons ============================== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding-inline: var(--sp-6);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    border: 1px solid transparent;
    transition: background-color 260ms ease, color 260ms ease, border-color 260ms ease;
  }
  .btn:hover { text-decoration: none; }
  .btn-fill { background: var(--cream); color: var(--ink); }
  .btn-fill:hover { background: var(--gold); color: var(--ink); }
  .btn-line { color: var(--cream); border-color: var(--hair-firm); }
  .btn-line:hover { border-color: var(--cream); background: rgb(247 244 238 / 0.07); }

  /* ============================== manifesto ============================= */
  .manifesto { padding-block: var(--sp-9) var(--sp-8); background: var(--ink); }
  .manifesto-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: var(--sp-9);
    align-items: center;
  }
  .manifesto-copy { display: flex; flex-direction: column; gap: var(--sp-4); }
  .manifesto h2 { font-size: var(--step-5); max-width: 13ch; color: var(--cream); }
  .lead {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1.38;
    color: var(--cream);
    max-width: 30ch;
  }
  .prose { font-size: var(--step-0); color: var(--ash); max-width: var(--measure); }
  .manifesto-plate { margin: 0; }

  /* A photograph mounted like a plate: a hairline, and a ground a shade off
     the page so the edge shows without a border announcing it. */
  .plate-frame {
    overflow: hidden;
    background: var(--ink-lift);
    outline: 1px solid var(--hair);
    outline-offset: -1px;
  }
  .plate-frame > div { margin-block: -8%; }

  .techniques {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    margin-top: var(--sp-8);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--hair);
  }
  .techniques li {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--gold);
  }

  @media (max-width: 980px) {
    /*
      One vertical veil on a phone, deepened through the middle band only.

      The desktop veil leans on a left-side wash that has faded out by 78% of
      the width; on a narrow screen the copy runs nearly edge to edge and the
      eyebrow sat over the model's white shirt at 2.6:1. Deepening the whole
      gradient fixed that but crushed his face. Measured against the actual
      pixels, this raises the band the eyebrow occupies to 5.4:1 while leaving
      the top of the frame LIGHTER than a uniform darkening would.
    */
    .hero-veil {
      background: linear-gradient(
        to top,
        rgb(11 10 9 / 0.94) 0%,
        rgb(11 10 9 / 0.86) 44%,
        rgb(11 10 9 / 0.58) 74%,
        rgb(11 10 9 / 0.36) 100%
      );
    }

    .manifesto { padding-block: var(--sp-8) var(--sp-7); }
    .manifesto-grid { grid-template-columns: minmax(0, 1fr); gap: var(--sp-6); }
    .manifesto h2 { font-size: var(--step-4); max-width: 16ch; }
    .techniques { margin-top: var(--sp-6); }
  }

  /* ============================= collections ============================ */
  .collections { padding-block: var(--sp-8) var(--sp-9); background: var(--ink); }
  .coll-head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    align-items: flex-start;
    padding-bottom: var(--sp-8);
  }
  .coll-head h2 { font-size: var(--step-5); color: var(--cream); }
  .rule { display: block; width: min(340px, 60%); height: 1px; background: var(--gold); }
  .coll-intro { font-size: var(--step-1); color: var(--ash); max-width: 48ch; }

  .coll { padding-block: var(--sp-8); }
  .coll + .coll { border-top: 1px solid var(--hair); }
  .coll-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-9);
    align-items: start;
  }
  .coll[data-side="right"] .coll-visual { order: 2; }
  .coll[data-side="right"] .coll-text   { order: 1; }

  /*
    The photograph holds while the words pass it. Sticky rather than drift for
    this one: a buyer should be able to keep looking at the garment for as
    long as it takes to read about it.
  */
  .coll-sticky { position: sticky; top: 100px; }
  .coll-frame {
    overflow: hidden;
    background: var(--ink-lift);
    outline: 1px solid var(--hair);
    outline-offset: -1px;
  }
  .coll-frame > div { margin-block: -6%; }

  .coll-inset {
    width: 46%;
    margin-top: calc(-1 * var(--sp-8));
    margin-left: auto;
    position: relative;
    z-index: 2;
    padding: 6px;
    background: var(--ink);
    outline: 1px solid var(--hair);
    outline-offset: -1px;
  }
  .coll[data-side="right"] .coll-inset { margin-left: 0; margin-right: auto; }

  .coll-text { display: flex; flex-direction: column; gap: var(--sp-4); padding-top: var(--sp-4); }
  /*
    The painting the collection came from, not a number. This is the fact the
    house is organised around; the two collections with no painting name their
    material instead.
  */
  .coll-origin {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--gold);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--hair);
  }
  .coll-name { font-size: var(--step-5); color: var(--cream); }
  .coll-line {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1.32;
    color: var(--cream);
    max-width: 22ch;
  }
  .coll-body { font-size: var(--step-0); color: var(--ash); max-width: 44ch; }
  .coll-credit {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-top: var(--sp-3);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--hair);
  }
  .coll-credit li {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
