---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import { loadProducts } from "../data/source.ts";
import JsonLd from "../components/JsonLd.astro";
import { organisationSchema, websiteSchema } from "../lib/seo/structured-data.ts";
import { BRAND, COMMERCE, COPY } from "../config/brand.ts";

const { products } = await loadProducts();
const featured = products.slice(0, 8);

const siteOrigin = (Astro.site ?? new URL("https://example.com")).origin;
---

<Base
  title={`${BRAND.name} — ${BRAND.tagline}`}
  description={BRAND.description}
>
  <Fragment slot="head">
    <JsonLd data={organisationSchema(siteOrigin, BRAND.name)} />
    <JsonLd data={websiteSchema(siteOrigin, BRAND.name)} />
  </Fragment>
  <section class="hero shell">
    <div class="hero-copy">
      {BRAND.eyebrow && <p class="label">{BRAND.eyebrow}</p>}
      <h1>{BRAND.tagline}</h1>
      <p class="hero-lede">{BRAND.intro}</p>
      <div class="hero-actions">
        <a href="/collections/all" class="btn">View the collection</a>
        <a href="/collections/dresses" class="btn ghost">Dresses</a>
      </div>
    </div>
  </section>

  <section class="shell trust">
    <div class="trust-item">
      <h2>Measured, not guessed</h2>
      <p>Garment measurements laid flat for every size, with instructions for taking your own.</p>
    </div>
    <div class="trust-item">
      <h2>Fit data in every review</h2>
      <p>Reviewers tell you their height and the size they bought. We publish the critical ones too.</p>
    </div>
    <div class="trust-item">
      <h2>{COPY.returnsShort}</h2>
      <p>{COMMERCE.exchangesSupported ? "Exchanges are one step. If the size is wrong, swapping it should be easy." : "Straightforward returns if the size is wrong."}</p>
    </div>
  </section>

  <section class="shell featured">
    <div class="featured-head">
      <h2>Selected styles</h2>
      <a href="/collections/all" class="more">All ten pieces</a>
    </div>
    <ul class="grid">
      {featured.map((product, i) => (
        <li><ProductCard product={product} loading={i < 4 ? "eager" : "lazy"} /></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero { padding-block: var(--sp-8) var(--sp-7); }
  .hero-copy { max-width: 48ch; display: flex; flex-direction: column; gap: var(--sp-4); }
  .hero h1 { font-size: var(--step-4); line-height: 1.04; }
  .hero-lede { font-size: var(--step-1); color: var(--ink-2); line-height: 1.5; }
  .hero-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-2); }

  .btn {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    padding: var(--sp-3) var(--sp-5);
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .btn:hover { text-decoration: none; opacity: 0.88; }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--rule-2); }
  .btn.ghost:hover { border-color: var(--ink); }

  .trust {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--sp-5);
    padding-block: var(--sp-6);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .trust-item { display: flex; flex-direction: column; gap: var(--sp-2); }
  .trust-item h2 { font-size: var(--step-0); }
  .trust-item p { font-size: var(--step--1); color: var(--ink-2); }

  .featured { padding-block: var(--sp-7) 0; }
  .featured-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
  }
  .featured-head h2 { font-size: var(--step-2); }
  .more { font-size: var(--step--1); color: var(--ink-2); }

  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(216px, 1fr));
    gap: var(--sp-6) var(--sp-5);
  }
  @media (max-width: 860px) {
    .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--sp-5) var(--sp-4); }
  }
</style>
