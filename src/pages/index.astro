---
/**
 * The Manussa page.
 *
 * One scrolling document with anchor navigation, as specified in the content
 * brief. Every string comes from src/data/site.ts, which is a transcription of
 * that brief — nothing on this page is written here.
 *
 * No JavaScript. The mobile menu is a <details> element, the section links are
 * anchors, and the smooth scroll is CSS. That is not minimalism for its own
 * sake: the first audience is buyers on trade-stand wifi, and a page that
 * needs nothing to execute cannot fail halfway.
 */
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import JsonLd from "../components/JsonLd.astro";
import lockupLight from "../assets/brand/lockup-light.png";
import monogramDark from "../assets/brand/monogram-dark.png";
import { Image } from "astro:assets";
import {
  BRAND, TEXWORLD, NAV, HERO, MANIFESTO, COLLECTIONS,
  ART, TECHNIQUES, HOUSE, VISIT, SOCIAL, FOOTER,
} from "../data/site.ts";

const site = Astro.site ?? new URL("https://manussa.example");

const organisation = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: BRAND.name,
  description: BRAND.description,
  url: site.href,
  parentOrganization: { "@type": "Organization", name: BRAND.parent },
  address: { "@type": "PostalAddress", addressLocality: "Yangon", addressCountry: "MM" },
  email: BRAND.email,
  slogan: BRAND.tagline,
};

/* The show is the reason the site exists this week, so it is described to
   search engines as an event rather than buried in prose. */
const event = {
  "@context": "https://schema.org",
  "@type": "ExhibitionEvent",
  name: `${BRAND.name} at ${TEXWORLD.event}`,
  startDate: TEXWORLD.start,
  endDate: TEXWORLD.end,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: `${TEXWORLD.event} — ${TEXWORLD.hall}, ${TEXWORLD.booth}`,
    address: { "@type": "PostalAddress", addressLocality: "Paris", addressCountry: "FR" },
  },
  organizer: { "@type": "Organization", name: BRAND.name, url: site.href },
};
---

<Base
  title={`${BRAND.name} — ${BRAND.tagline}`}
  description={BRAND.description}
  ogImage={HERO.image}
>
  <JsonLd data={organisation} slot="head" />
  <JsonLd data={event} slot="head" />

  <!-- ============================ header ============================ -->
  <header class="site-head" slot="header">
    <div class="shell head-inner">
      <a href="#top" class="brand" aria-label={`${BRAND.name} — home`}>
        <Image src={monogramDark} alt="" width={30} height={29} class="brand-mark" densities={[1, 2]} />
        <span class="brand-word">{BRAND.name}</span>
      </a>

      <nav class="nav-wide" aria-label="Sections">
        <ul>
          {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <a class="head-cta" href="#visit">Contact</a>

      <!-- Mobile menu. <details> gives a disclosure with no script; the
           summary is the button and the panel is its content. -->
      <details class="menu">
        <summary aria-label="Open menu">
          <span class="menu-bars" aria-hidden="true"></span>
          <span class="menu-word">Menu</span>
        </summary>
        <ul class="menu-panel">
          {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href={`mailto:${BRAND.email}`}>Contact</a></li>
        </ul>
      </details>
    </div>
  </header>

  <!-- ============================= hero ============================= -->
  <section class="hero" id="top" aria-labelledby="hero-h">
    <div class="hero-media">
      <Photo src={HERO.image} alt="" sizes="100vw" priority />
    </div>
    <div class="hero-veil" aria-hidden="true"></div>

    <div class="shell hero-inner">
      <p class="hero-eyebrow">{HERO.eyebrow}</p>
      <h1 id="hero-h" class="hero-mark">
        <Image src={lockupLight} alt={BRAND.name} widths={[420, 640, 840]}
               sizes="(max-width: 700px) 78vw, 520px" loading="eager" />
      </h1>
      <p class="hero-tagline">{HERO.tagline}</p>
      <div class="hero-actions">
        <a class="btn btn-solid" href={HERO.primary.href}>{HERO.primary.label}</a>
        <a class="btn btn-ghost" href={HERO.secondary.href}>{HERO.secondary.label}</a>
      </div>
    </div>
  </section>

  <!-- =========================== manifesto ========================== -->
  <section class="manifesto" aria-labelledby="manifesto-h">
    <div class="shell manifesto-inner">
      <div class="manifesto-copy">
        <p class="eyebrow">From Painting to Clothes</p>
        <h2 id="manifesto-h">{MANIFESTO.heading}</h2>
        <p class="lead">{MANIFESTO.lead}</p>
        <p class="body">{MANIFESTO.body}</p>
        <ul class="techniques" aria-label="Techniques">
          {TECHNIQUES.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <figure class="manifesto-figure">
        <Photo src={MANIFESTO.image} alt={MANIFESTO.imageAlt}
               sizes="(max-width: 900px) 92vw, 560px" />
      </figure>
    </div>
  </section>

  <!-- ========================== collections ========================= -->
  <section class="collections" id="collections" aria-labelledby="collections-h">
    <div class="shell collections-head">
      <p class="eyebrow">2026 · {BRAND.concept}</p>
      <h2 id="collections-h">The Collections</h2>
      <p class="collections-intro">
        Five collections, each born from a painting — limited-edition art pieces
        and everyday ready-to-wear, all made to be worn.
      </p>
    </div>

    {COLLECTIONS.map((c, i) => (
      <article class="row" id={c.handle} data-flip={i % 2 === 1 ? "true" : "false"}>
        <div class="shell row-inner">
          <div class="row-media">
            <Photo src={c.image} alt={c.imageAlt}
                   sizes="(max-width: 900px) 92vw, 620px" />
            {c.detail && (
              <div class="row-detail">
                <Photo src={c.detail} alt={c.detailAlt ?? ""}
                       sizes="(max-width: 900px) 44vw, 260px" />
              </div>
            )}
          </div>

          <div class="row-copy">
            <p class="row-no">{c.no}</p>
            <h3 class="row-name">{c.name}</h3>
            <p class="row-tagline">{c.tagline}</p>
            <ul class="row-credit">
              {c.credit.map((line) => <li>{line}</li>)}
            </ul>
            <p class="row-body">{c.body}</p>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- ============================= art ============================== -->
  <section class="art" id="artists" aria-labelledby="art-h">
    <div class="shell art-inner">
      <div class="art-copy">
        <p class="eyebrow art-eyebrow">{ART.eyebrow}</p>
        <h2 id="art-h">{ART.heading}</h2>
        <p class="art-body">{ART.body}</p>
        <ul class="art-names">
          {ART.names.map((n) => <li>{n}</li>)}
        </ul>
      </div>
      <div class="art-plates">
        {ART.images.map((img) => (
          <figure>
            <Photo src={img.src} alt={img.alt} sizes="(max-width: 900px) 92vw, 380px" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ house ============================= -->
  <section class="house" id="house" aria-labelledby="house-h">
    <div class="shell house-inner">
      <div class="house-head">
        <p class="eyebrow">The House</p>
        <h2 id="house-h">{HOUSE.heading}</h2>
        <p class="house-intro">{HOUSE.intro}</p>
      </div>
      <ul class="founders">
        {HOUSE.founders.map((f) => (
          <li class="founder">
            <h3 class="founder-name">{f.name}</h3>
            <p class="founder-role">{f.role}</p>
            <p class="founder-body">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================ visit ============================= -->
  <section class="visit" id="visit" aria-labelledby="visit-h">
    <div class="visit-media">
      <Photo src={VISIT.image} alt="" sizes="100vw" />
    </div>
    <div class="visit-veil" aria-hidden="true"></div>

    <div class="shell visit-inner">
      <p class="eyebrow visit-eyebrow">{VISIT.eyebrow}</p>
      <h2 id="visit-h">{VISIT.heading}</h2>
      <p class="visit-body">{VISIT.body}</p>

      <dl class="visit-facts">
        <div><dt>Hall</dt><dd>{TEXWORLD.hall.replace("Hall ", "")}</dd></div>
        <div><dt>Booth</dt><dd>{TEXWORLD.booth.replace("Booth ", "")}</dd></div>
        <div><dt>Dates</dt><dd><time datetime={TEXWORLD.start}>{TEXWORLD.datesLong}</time></dd></div>
      </dl>

      <a class="btn btn-solid" href={VISIT.cta.href}>{VISIT.cta.label}</a>
    </div>
  </section>

  <!-- ============================ footer ============================ -->
  <footer class="site-foot" slot="footer">
    <div class="shell foot-inner">
      <div class="foot-brand">
        <span class="foot-word">{BRAND.name}</span>
        <p class="foot-blurb">{BRAND.blurb}</p>
        {SOCIAL.length > 0 && (
          <ul class="foot-social">
            {SOCIAL.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
          </ul>
        )}
      </div>

      <nav class="foot-col" aria-label="Explore">
        <p class="foot-label">Explore</p>
        <ul>
          {FOOTER.explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="foot-col">
        <p class="foot-label">Contact</p>
        <ul>
          <li><a href={`mailto:${BRAND.email}`}>{BRAND.email}</a></li>
          <li><a href={BRAND.websiteUrl} rel="noopener">{BRAND.website}</a></li>
          <li><span class="foot-static">{BRAND.city}</span></li>
          <li>
            <span class="foot-static">
              {TEXWORLD.event}, {TEXWORLD.hall}, {TEXWORLD.booth}, {TEXWORLD.dates}
            </span>
          </li>
        </ul>
      </div>

      <p class="foot-legal">{FOOTER.legal}</p>
    </div>
  </footer>
</Base>

<style>
  /* =============================== header =============================== */
  .site-head {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .head-inner {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    min-height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin-right: auto;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark { width: 26px; height: auto; }
  .brand-word {
    font-family: var(--display);
    font-size: var(--step-1);
    text-transform: uppercase;
    letter-spacing: 0.34em;
    /* Uppercase letter-spacing adds a trailing gap; pull it back so the
       wordmark sits optically centred against the mark. */
    margin-right: -0.34em;
  }

  .nav-wide ul { display: flex; gap: var(--sp-6); }
  .nav-wide a {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-2);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .nav-wide a:hover { color: var(--ink); }

  .head-cta {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    border: 1px solid var(--ink);
    padding-inline: var(--sp-5);
    min-height: 40px;
    display: inline-flex;
    align-items: center;
  }
  .head-cta:hover { background: var(--ink); color: var(--cream); text-decoration: none; }

  /* Mobile disclosure menu — no script. */
  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding-inline: var(--sp-2);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-bars {
    width: 18px; height: 10px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .menu[open] .menu-bars { border-bottom-color: transparent; }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 220px;
    background: var(--cream-2);
    border: 1px solid var(--rule);
    padding: var(--sp-2);
    box-shadow: 0 18px 40px rgb(20 18 16 / 0.10);
  }
  .menu-panel a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: var(--sp-4);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .menu-panel a:hover { background: var(--cream-3); text-decoration: none; }

  @media (max-width: 900px) {
    .nav-wide, .head-cta { display: none; }
    .menu { display: block; }
    .head-inner { min-height: 60px; }
    .brand-word { font-size: var(--step-0); letter-spacing: 0.28em; margin-right: -0.28em; }
  }

  /* ================================ hero ================================ */
  .hero {
    position: relative;
    min-height: min(92vh, 900px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    /* Fixed literal: the copy above is always cream, so this ground must stay
       dark whatever else changes. */
    background: #141210;
  }
  .hero-media { position: absolute; inset: 0; }
  .hero-media :global(picture) { display: block; width: 100%; height: 100%; }
  .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; }

  /*
    Two gradients. The vertical one alone had to be very heavy to hold text
    over the bright car and white denim; a left-side wash lets the copy column
    darken while the right of the frame keeps its depth.
  */
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgb(12 10 9 / 0.78) 0%, rgb(12 10 9 / 0.42) 44%, rgb(12 10 9 / 0) 76%),
      linear-gradient(to top, rgb(12 10 9 / 0.90) 0%, rgb(12 10 9 / 0.62) 34%, rgb(12 10 9 / 0.22) 68%, rgb(12 10 9 / 0.10) 100%);
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-5);
    padding-block: var(--sp-9) var(--sp-8);
  }
  /* Opaque cream, never translucent white — text over a photograph cannot
     reach contrast through an alpha channel however dark the veil is. */
  .hero-eyebrow {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--cream);
  }
  .hero-mark { margin: 0; line-height: 0; }
  .hero-mark :global(img) { width: min(520px, 78vw); height: auto; }
  .hero-tagline {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1.2;
    color: var(--cream);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--sp-4); margin-top: var(--sp-3); }

  /* ============================== buttons =============================== */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding-inline: var(--sp-6);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    border: 1px solid transparent;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .btn:hover { text-decoration: none; }
  .btn-solid { background: var(--cream); color: #141210; }
  .btn-solid:hover { background: var(--gold); color: #141210; }
  .btn-ghost { color: var(--cream); border-color: rgb(247 244 238 / 0.55); }
  .btn-ghost:hover { border-color: var(--cream); background: rgb(247 244 238 / 0.10); }

  /* ============================= manifesto ============================== */
  .manifesto { padding-block: var(--sp-9); }
  .manifesto-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--sp-8);
    align-items: center;
  }
  .manifesto-copy { display: flex; flex-direction: column; gap: var(--sp-4); }
  .manifesto h2 {
    font-size: var(--step-5);
    max-width: 15ch;
  }
  .lead {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.42;
    color: var(--ink-2);
    max-width: 34ch;
  }
  .body { font-size: var(--step-0); color: var(--ink-2); max-width: var(--measure); }

  .techniques {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    margin-top: var(--sp-3);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
  }
  .techniques li {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--gold-ink);
  }

  .manifesto-figure { margin: 0; }

  @media (max-width: 900px) {
    /*
      One deeper vertical gradient on a phone.

      The desktop veil leans on a left-side wash that fades out by 76% of the
      width. On a 375px screen the copy runs nearly edge to edge, so the right
      half of the eyebrow sat over the bright white denim at 3.5:1. Measured
      against the actual pixels: this is the lightest set that clears AA, and
      the eyebrow lands at 5.0:1.
    */
    .hero-veil {
      background: linear-gradient(
        to top,
        rgb(12 10 9 / 0.92) 0%,
        rgb(12 10 9 / 0.78) 40%,
        rgb(12 10 9 / 0.52) 72%,
        rgb(12 10 9 / 0.34) 100%
      );
    }

    .manifesto { padding-block: var(--sp-8); }
    .manifesto-inner { grid-template-columns: minmax(0, 1fr); gap: var(--sp-6); }
    .manifesto h2 { font-size: var(--step-4); max-width: 18ch; }
  }

  /* ============================ collections ============================= */
  .collections { padding-block: var(--sp-8) var(--sp-9); background: var(--cream-3); }
  .collections-head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-bottom: var(--sp-8);
    text-align: center;
    align-items: center;
  }
  .collections-head h2 { font-size: var(--step-5); }
  .collections-intro {
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 52ch;
  }

  .row { padding-block: var(--sp-7); }
  .row + .row { border-top: 1px solid var(--rule); }
  .row-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--sp-8);
    align-items: center;
  }
  /*
    Alternate the side the photograph sits on, so five rows read as a sequence
    rather than a list. Order, not flex-direction — reversing visually would
    also reverse the reading order for a screen reader.

    The column widths swap with it. Without that the photograph would be 546px
    on odd rows and 494px on even ones, and the run of five would look like a
    mistake rather than a rhythm.
  */
  .row[data-flip="true"] .row-inner { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); }
  .row[data-flip="true"] .row-media { order: 2; }
  .row[data-flip="true"] .row-copy  { order: 1; }

  .row-media { position: relative; }
  .row-detail {
    position: absolute;
    right: -6%;
    bottom: -10%;
    width: 42%;
    border: 6px solid var(--cream-3);
    background: var(--cream-3);
  }
  .row[data-flip="true"] .row-detail { right: auto; left: -6%; }

  .row-copy { display: flex; flex-direction: column; gap: var(--sp-3); }
  .row-no {
    font-family: var(--display);
    font-size: var(--step-3);
    line-height: 1;
    /* Not --gold: the collections sit on cream-3, where the brand value is
       2.84:1 and large text needs 3.0. */
    color: var(--gold-large);
    font-variant-numeric: tabular-nums;
  }
  .row-name { font-size: var(--step-4); }
  .row-tagline {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink-2);
    max-width: 26ch;
  }
  .row-credit {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: var(--sp-3);
    border-top: 1px solid var(--rule-2);
    border-bottom: 1px solid var(--rule-2);
  }
  .row-credit li {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }
  .row-body { font-size: var(--step-0); color: var(--ink-2); max-width: 46ch; }

  @media (max-width: 900px) {
    .collections { padding-block: var(--sp-7) var(--sp-8); }
    .collections-head { padding-bottom: var(--sp-6); }
    .collections-head h2 { font-size: var(--step-4); }
    .row-inner { grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); }
    /* On one column the flip would put the photograph after the copy for some
       rows and before it for others. Keep it consistent instead. */
    .row[data-flip="true"] .row-inner { grid-template-columns: minmax(0, 1fr); }
    .row[data-flip="true"] .row-media,
    .row[data-flip="true"] .row-copy { order: initial; }
    .row-detail {
      position: static;
      width: 58%;
      margin: calc(-1 * var(--sp-6)) 0 0 auto;
      border-width: 5px;
      position: relative;
    }
    .row[data-flip="true"] .row-detail { margin-inline: auto 0; }
    .row-name { font-size: var(--step-3); }
  }

  /* ================================ art ================================= */
  .art { background: var(--ink); color: var(--cream); padding-block: var(--sp-9); }
  .art-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-8);
    align-items: center;
  }
  .art-eyebrow { color: var(--gold); }
  .art-copy { display: flex; flex-direction: column; gap: var(--sp-4); }
  .art h2 { font-size: var(--step-5); max-width: 16ch; }
  .art-body {
    font-size: var(--step-0);
    /* Cream at full strength on ink; the muted variants are for the light
       sections and would sit near 3:1 here. */
    color: #E4DED2;
    max-width: var(--measure);
  }
  .art-names {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
