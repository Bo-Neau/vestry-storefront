---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductImage from "../components/ProductImage.astro";
import JsonLd from "../components/JsonLd.astro";
import { organisationSchema, websiteSchema } from "../lib/seo/structured-data.ts";
import { BRAND, COMMERCE, COPY } from "../config/brand.ts";
import { loadProducts } from "../data/source.ts";
import { LOOKS, piecesFor, lookTotal } from "../data/looks.ts";
import { formatMoney } from "../lib/money.ts";

const { products } = await loadProducts();
const siteOrigin = (Astro.site ?? new URL("https://example.com")).origin;

const looks = LOOKS.map((look) => {
  const pieces = piecesFor(look, products);
  return { look, pieces, hero: pieces.find((p) => p.handle === look.heroHandle) ?? pieces[0] };
}).filter((l) => l.pieces.length > 0);

const CATEGORIES = [
  { title: "Outerwear", href: "/collections/outerwear", note: "Painted, stitched and pieced", lead: "painted-capelet" },
  { title: "Tops",      href: "/collections/tops",      note: "Sculptural bodices",           lead: "painted-corset-bodice" },
  { title: "Skirts",    href: "/collections/skirts",    note: "Narrow, then fluted",           lead: "raw-silk-fluted-skirt" },
  { title: "Dresses",   href: "/collections/dresses",   note: "Columns and gowns",             lead: "coral-embroidered-gown" },
];

/** Named piece first; fall back to anything in the category if it moves. */
const categoryLead = (c: { title: string; lead: string }) =>
  products.find((p) => p.handle === c.lead)
  ?? products.find((p) => p.category === c.title)
  ?? products[0];

const featured = products.slice(0, 8);
---

<Base title={`${BRAND.name} — ${BRAND.tagline}`} description={BRAND.description}>
  <Fragment slot="head">
    <JsonLd data={organisationSchema(siteOrigin, BRAND.name)} />
    <JsonLd data={websiteSchema(siteOrigin, BRAND.name)} />
  </Fragment>

  <!--
    Full-bleed opening, the way the booklet opens: the collection on its
    stands, with the brand's own line over it. The image is the LCP element,
    so it loads eagerly at high priority and nothing else competes with it.
  -->
  <section class="hero" aria-labelledby="hero-title">
    <img
      class="hero-img"
      src="/photography/collection-lineup.jpg"
      width="2016" height="1344"
      alt="The Manussa collection shown on stands against carved wood"
      fetchpriority="high"
      decoding="sync"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-copy">
      {BRAND.eyebrow && <p class="label">{BRAND.eyebrow}</p>}
      <h1 id="hero-title">{BRAND.tagline}</h1>
      <p class="hero-lede">{BRAND.intro}</p>
      <div class="hero-actions">
        <a href="/collections/all" class="btn">View the collection</a>
        {looks[0] && (
          <a href={`/looks/${looks[0].look.handle}`} class="btn ghost">
            {looks[0].look.title}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Shop the look: outfit merchandising, which answers "what do I wear
       this with" rather than "here are more products". -->
  <section class="shell looks" aria-labelledby="looks-title">
    <div class="sec-head">
      <p class="label">Styled together</p>
      <h2 id="looks-title">Shop the look</h2>
    </div>

    <ul class="look-list">
      {looks.map(({ look, pieces, hero }) => (
        <li class="look">
          <a href={`/looks/${look.handle}`} class="look-media" tabindex="-1" aria-hidden="true">
            {hero && (
              <ProductImage
                colorway={hero.colorways[0]!}
                shape={hero.shape}
                view="front"
                alt=""
                sizes="(max-width: 860px) 92vw, (max-width: 1320px) 44vw, 420px"
              />
            )}
          </a>
          <div class="look-body">
            <h3><a href={`/looks/${look.handle}`}>{look.title}</a></h3>
            <p class="look-note">{look.note}</p>
            <p class="look-meta">
              {pieces.map((p) => p.title).join(" · ")}
            </p>
            <p class="look-price money">
              {formatMoney({ amount: lookTotal(pieces), currency: "USD" })} together
            </p>
            <a href={`/looks/${look.handle}`} class="btn small">Shop this look</a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Category entries, as images rather than a text menu. -->
  <section class="shell cats" aria-labelledby="cats-title">
    <div class="sec-head">
      <p class="label">By category</p>
      <h2 id="cats-title">The collection</h2>
    </div>
    <ul class="cat-list">
      {CATEGORIES.map((c) => {
        const lead = categoryLead(c);
        return (
          <li class="cat">
            <a href={c.href}>
              <span class="cat-media" aria-hidden="true">
                {lead && (
                  <ProductImage
                    colorway={lead.colorways[0]!}
                    shape={lead.shape}
                    view="front"
                    alt=""
                    sizes="(max-width: 860px) 46vw, (max-width: 1320px) 24vw, 300px"
                  />
                )}
              </span>
              <span class="cat-text">
                <span class="cat-title">{c.title}</span>
                <span class="cat-note">{c.note}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="atelier" aria-label="The atelier">
    <img
      src="/photography/atelier-group.jpg"
      width="1218" height="812"
      alt="The Manussa team wearing pieces from the collection"
      loading="lazy" decoding="async"
    />
    <p class="atelier-note">
      Founded by an art collector, a designer and a maker raised in an artistic
      family — bound by one purpose: to craft contemporary pieces that honour
      traditional textiles and hand-worked embroidery.
    </p>
  </section>

  <section class="shell trust">
    <div class="trust-item">
      <h2>Measured, not guessed</h2>
      <p>Garment measurements laid flat for every size, with instructions for taking your own.</p>
    </div>
    <div class="trust-item">
      <h2>Fit data in every review</h2>
      <p>Reviewers tell you their height and the size they bought. We publish the critical ones too.</p>
    </div>
    <div class="trust-item">
      <h2>{COPY.returnsShort}</h2>
      <p>{COMMERCE.exchangesSupported ? "Exchanges are one step. If the size is wrong, swapping it should be easy." : "Most pieces are cut to order, so please check the measurements before ordering."}</p>
    </div>
  </section>

  <section class="shell featured">
    <div class="featured-head">
      <h2>Selected pieces</h2>
      <a href="/collections/all" class="more">The full collection</a>
    </div>
    <ul class="grid">
      {featured.map((product, i) => (
        <li><ProductCard product={product} loading={i < 4 ? "eager" : "lazy"} /></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    min-height: min(82vh, 760px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    /*
      The colour the photograph is laid over, and what shows if it fails to
      load. The hero copy on top is always white, so this has to stay dark in
      every theme — var(--ink) inverts to near-white in dark mode.
    */
    background: #14130F;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  /*
    The photograph is dark and busy at the base, so type needs a ground to sit
    on. A gradient rather than a flat wash keeps the garments readable at the
    top while the copy stays legible at the bottom.
  */
  /*
    Two layers, not one. The vertical gradient alone had to be crushingly dark
    to beat the pale gown the headline crosses; adding a left-side wash means
    the copy column can be dark while the right of the frame — the globe, the
    black jacket — keeps its depth. Measured against the actual pixels of
    collection-lineup.jpg: worst-case behind the headline is 11.8:1.
  */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgb(10 9 7 / 0.80) 0%,
        rgb(10 9 7 / 0.40) 46%,
        rgb(10 9 7 / 0) 78%
      ),
      linear-gradient(
        to top,
        rgb(10 9 7 / 0.94) 0%,
        rgb(10 9 7 / 0.82) 36%,
        rgb(10 9 7 / 0.46) 66%,
        rgb(10 9 7 / 0.14) 100%
      );
  }
  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-8) var(--sp-6);
    max-width: 58ch;
    width: 100%;
    margin: 0 auto;
    max-width: var(--maxw);
  }
  /* Fixed light values, not tokens: this type always sits on a dark
     photograph, whichever theme the visitor is in. */
  .hero-copy .label { color: #FFFFFF; }
  .hero-copy h1 {
    font-size: var(--step-4);
    line-height: 1.02;
    color: #FFFFFF;
    max-width: 14ch;
    letter-spacing: 0.01em;
  }
  .hero-lede {
    font-size: var(--step-1);
    color: #FFFFFF;
    line-height: 1.5;
    max-width: 46ch;
  }
  .hero-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-2); }
  /*
    Fixed literals on both sides, not tokens.

    This button sits on a photograph that is dark in every theme, so its
    surface never flips — but var(--ink) does. In dark mode that resolved to
    near-white text on a white button. A colour pinned to a fixed surface has
    to be pinned too.
  */
  .hero .btn {
    background: #FFFFFF;
    color: #14130F;
  }
  .hero .btn:hover { background: rgb(255 255 255 / 0.9); opacity: 1; }
  .hero .btn.ghost {
    background: transparent;
    color: #FFFFFF;
    border-color: rgb(255 255 255 / 0.5);
  }
  .hero .btn.ghost:hover { border-color: #FFFFFF; }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    background: var(--ink);
    color: var(--paper);
    padding: 0 var(--sp-5);
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .btn:hover { text-decoration: none; opacity: 0.88; }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--rule-2); }
  .btn.ghost:hover { border-color: var(--ink); opacity: 1; }
  .btn.small { min-height: 44px; align-self: flex-start; }

  .sec-head { display: flex; flex-direction: column; gap: var(--sp-2); margin-bottom: var(--sp-5); }
  .sec-head h2 { font-size: var(--step-3); letter-spacing: -0.02em; }

  /* ---------- looks ---------- */
  .looks { padding-block: var(--sp-8) var(--sp-7); }
  .look-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-6) var(--sp-5);
  }
  .look { display: flex; flex-direction: column; gap: var(--sp-4); }
  .look-media { display: block; background: var(--paper-3); overflow: hidden; }
  .look-media :global(.garment) { transition: transform .6s ease; }
  .look:hover .look-media :global(.garment) { transform: scale(1.03); }
  .look-body { display: flex; flex-direction: column; gap: var(--sp-2); }
  .look-body h3 { font-size: var(--step-2); letter-spacing: -0.018em; }
  .look-note { font-size: var(--step--1); color: var(--ink-2); max-width: 40ch; }
  .look-meta {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-3);
  }
  .look-price { font-size: var(--step-0); margin-top: var(--sp-1); }

  /* ---------- categories ---------- */
  .cats { padding-block: var(--sp-7); border-top: 1px solid var(--rule); }
  .cat-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-4);
  }
  .cat a { display: flex; flex-direction: column; gap: var(--sp-3); }
  .cat a:hover { text-decoration: none; }
  .cat-media { display: block; background: var(--paper-3); overflow: hidden; }
  .cat-media :global(.garment) { transition: transform .5s ease; }
  .cat a:hover .cat-media :global(.garment) { transform: scale(1.03); }
  .cat-text { display: flex; flex-direction: column; gap: 2px; }
  .cat-title {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }
  .cat-note { font-size: var(--step--1); color: var(--ink-3); }

  /* ---------- atelier ---------- */
  .atelier {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: center;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: var(--sp-7) var(--sp-5);
  }
  .atelier img { width: 100%; height: auto; }
  .atelier-note {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink-2);
    max-width: 32ch;
  }
  @media (max-width: 860px) {
    .atelier { grid-template-columns: minmax(0, 1fr); gap: var(--sp-4); padding-inline: var(--sp-4); }
    .atelier-note { font-size: var(--step-1); max-width: none; }
  }

  /* ---------- trust ---------- */
  .trust {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--sp-5);
    padding-block: var(--sp-6);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .trust-item { display: flex; flex-direction: column; gap: var(--sp-2); }
  .trust-item h2 { font-size: var(--step-0); }
  .trust-item p { font-size: var(--step--1); color: var(--ink-2); }

  /* ---------- featured ---------- */
  .featured { padding-block: var(--sp-7) 0; }
  .featured-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--sp-4); margin-bottom: var(--sp-5);
  }
  .featured-head h2 { font-size: var(--step-2); }
  .more {
    font-size: var(--step--1);
    color: var(--ink-2);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(216px, 1fr));
    gap: var(--sp-6) var(--sp-5);
  }

  @media (max-width: 900px) {
    .hero { min-height: min(74vh, 620px); }
    .hero-copy { padding: var(--sp-7) var(--sp-4) var(--sp-6); }
    .hero-copy h1 { max-width: 100%; }
    /*
      On a narrow screen the copy is taller and reaches further up the frame,
      into the pale mannequins. The desktop gradient runs out before it gets
      there, so carry the dark further and hold it longer.
    */
    /*
      Narrow viewports crop the photograph to its centre, putting the pale
      gown directly behind the eyebrow, and the copy runs full width so the
      side wash has nothing to fade toward. One deeper vertical layer instead.
      Lightest set that clears AA on every line: eyebrow lands at 5.1:1.
    */
    .hero-scrim {
      background: linear-gradient(
        to top,
        rgb(10 9 7 / 0.93) 0%,
        rgb(10 9 7 / 0.84) 46%,
        rgb(10 9 7 / 0.52) 74%,
        rgb(10 9 7 / 0.16) 100%
      );
    }
  }
  @media (max-width: 860px) {
    .grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: var(--sp-5) var(--sp-3); }
    .cat-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .look-media :global(.garment),
    .cat-media :global(.garment) { transition: none; }
    .look:hover .look-media :global(.garment),
    .cat a:hover .cat-media :global(.garment) { transform: none; }
  }
</style>
