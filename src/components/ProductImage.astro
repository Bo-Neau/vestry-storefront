---
/**
 * Renders real photography when it exists, the generated placeholder when it
 * does not — so the storefront works before a shoot is booked and needs no
 * code change afterwards.
 *
 * Three things here are not decoration:
 *
 *  - `width`/`height` are always emitted, so the browser reserves space and
 *    the grid does not reflow as images arrive (Cumulative Layout Shift).
 *  - `sizes` describes the layout, not the image. Getting it wrong is the
 *    most common cause of a slow collection page: without it browsers assume
 *    100vw and fetch a 1200px file for a 180px slot.
 *  - The first gallery image gets `fetchpriority="high"` and eager loading.
 *    It is the LCP element, and Farfetch measured 1.3% conversion gain per
 *    100ms of LCP improvement.
 */
import type { Colorway, GarmentShape, ProductImage } from "../data/schema.ts";
import { buildUrl, buildSrcset, canTransform, FORMAT_PREFERENCE, mimeFor } from "../lib/images/provider.ts";
import Garment from "./Garment.astro";

interface Props {
  colorway: Colorway;
  shape: GarmentShape;
  view: "front" | "back" | "flat" | "detail";
  alt: string;
  /** CSS sizes attribute. Describe the SLOT, not the file. */
  sizes: string;
  /** True only for the LCP candidate — at most one per page. */
  priority?: boolean;
}

const { colorway, shape, view, alt, sizes, priority = false } = Astro.props;

const image: ProductImage | undefined =
  colorway.images?.find((i) => i.view === view);

// Only offer responsive sources when the CDN can genuinely produce them.
const transformable = image ? canTransform(image.src) : false;
---

{image && transformable ? (
  <picture>
    {FORMAT_PREFERENCE.map((format) => (
      <source
        type={mimeFor(format)}
        srcset={buildSrcset(image.src, format, image.width)}
        sizes={sizes}
      />
    ))}
    <img
      src={buildUrl(image.src, 900, "jpg")}
      srcset={buildSrcset(image.src, "jpg", image.width)}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={alt}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding={priority ? "sync" : "async"}
      class="product-img"
    />
  </picture>
) : image ? (
  <img
    src={image.src}
    width={image.width}
    height={image.height}
    alt={alt}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding={priority ? "sync" : "async"}
    class="product-img"
  />
) : (
  <Garment
    shape={shape}
    hex={colorway.hex}
    hexAlt={colorway.hexAlt}
    view={view}
    alt={alt}
    loading={priority ? "eager" : "lazy"}
  />
)}

<style>
  .product-img {
    width: 100%;
    height: auto;
    /* Matches the placeholder's ratio so swapping in photography does not
       change the layout. */
    aspect-ratio: 400 / 520;
    object-fit: cover;
    background: var(--paper-3);
  }
</style>
