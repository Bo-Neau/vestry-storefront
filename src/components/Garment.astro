---
/**
 * Placeholder product imagery, generated as SVG.
 *
 * A real storefront swaps this component for <img> against the client's
 * photography (2048px masters, AVIF/WebP, responsive srcset). It exists so
 * the gallery mechanics — four distinct views including a fabric macro —
 * can be built and reviewed before a shoot is booked.
 *
 * Silhouettes are tinted by colorway so swatch changes are visible, and
 * heathered yarns render as a two-tone blend.
 */
import type { GarmentShape } from "../data/schema.ts";

interface Props {
  shape: GarmentShape;
  hex: string;
  hexAlt?: string | undefined;
  view?: "front" | "back" | "flat" | "detail";
  alt: string;
  loading?: "eager" | "lazy";
}

const { shape, hex, hexAlt, view = "front", alt, loading = "lazy" } = Astro.props;

// Stable id per instance so gradients/patterns don't collide across a grid.
const uid = Math.random().toString(36).slice(2, 9);

/**
 * Silhouettes for the collection: cropped and longer painted jackets, a
 * structured capelet, fitted peplum tops, fluted skirts and a bias column.
 * Drawn to the same 400x520 frame as the photography crop, so replacing
 * these with real images changes no layout.
 */
const BODY: Record<GarmentShape, string> = {
  // cropped, open front, three-quarter sleeve
  jacket: "M158 98 L112 128 L96 268 L134 280 L140 342 L260 342 L266 280 L304 268 L288 128 L242 98 L200 126 Z",
  // structured capelet, flaring from a firm shoulder
  cape: "M176 104 L118 148 L92 300 L308 300 L282 148 L224 104 L200 124 Z",
  // fitted bodice released into a short peplum
  top: "M162 106 L146 140 L143 296 L118 372 L282 372 L257 296 L254 140 L238 106 C230 124 216 132 200 132 C184 132 170 124 162 106 Z",
  // narrow to the knee, then fluted
  skirt: "M144 148 L136 200 L124 336 L106 472 L294 472 L276 336 L264 200 L256 148 Z",
  // bias column, high neck, long sleeve
  gown: "M166 96 L146 138 L138 470 L262 470 L254 138 L234 96 Z",
};

/**
 * Surface, not garment type: the painted cotton and wool crepe read as a
 * twill, raw silk as a slubbed weave, and the bias crepe as a fine plain
 * weave. The fabric-detail view scales whichever applies.
 */
const TEXTURE: Record<GarmentShape, string> = {
  jacket: "twill", cape: "twill", top: "slub", skirt: "twill", gown: "woven",
};
const texture = TEXTURE[shape];
const isDetail = view === "detail";
---

<svg
  viewBox="0 0 400 520"
  role="img"
  aria-label={alt}
  class="garment"
  data-view={view}
  data-loading={loading}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={`g-${uid}`} x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0%" stop-color={hexAlt ?? hex} stop-opacity="1" />
      <stop offset="55%" stop-color={hex} stop-opacity="1" />
      <stop offset="100%" stop-color={hex} stop-opacity="0.86" />
    </linearGradient>

    {texture === "woven" && (
      <pattern id={`t-${uid}`} width="7" height="7" patternUnits="userSpaceOnUse">
        <path d="M0 0 H7 M0 3.5 H7" stroke="#000" stroke-opacity="0.055" stroke-width="1" />
        <path d="M0 0 V7 M3.5 0 V7" stroke="#fff" stroke-opacity="0.05" stroke-width="1" />
      </pattern>
    )}
    {texture === "slub" && (
      <pattern id={`t-${uid}`} width="12" height="12" patternUnits="userSpaceOnUse">
        <path d="M0 3 H12 M0 8 H12" stroke="#000" stroke-opacity="0.05" stroke-width="1" />
        <path d="M2 0 V12 M9 0 V12" stroke="#000" stroke-opacity="0.04" stroke-width="1" />
        {/* irregular slubs, which is what distinguishes raw silk by eye */}
        <path d="M3 5 h3 M7 10 h4 M1 9 h2" stroke="#000" stroke-opacity="0.10" stroke-width="1.6" />
      </pattern>
    )}
    {texture === "twill" && (
      <pattern id={`t-${uid}`} width="8" height="8" patternUnits="userSpaceOnUse">
        <path d="M-2 6 L6 -2 M2 10 L10 2" stroke="#000" stroke-opacity="0.07" stroke-width="1.6" />
      </pattern>
    )}

    <radialGradient id={`bg-${uid}`} cx="0.5" cy="0.38" r="0.78">
      <stop offset="0%" stop-color="var(--paper-2)" />
      <stop offset="100%" stop-color="var(--paper-3)" />
    </radialGradient>
  </defs>

  <rect width="400" height="520" fill={`url(#bg-${uid})`} />

  {isDetail ? (
    <g>
      <rect x="40" y="60" width="320" height="400" rx="2" fill={`url(#g-${uid})`} />
      <rect x="40" y="60" width="320" height="400" rx="2" fill={`url(#t-${uid})`}
            style={`transform: scale(3.2); transform-origin: 200px 260px;`} />
      <rect x="40" y="60" width="320" height="400" rx="2" fill="none"
            stroke="#000" stroke-opacity="0.1" stroke-width="1" />
      <text x="200" y="492" text-anchor="middle" class="g-cap">Fabric detail</text>
    </g>
  ) : (
    <g>
      <ellipse cx="200" cy="486" rx="128" ry="13" fill="#000" opacity="0.06" />

      <g transform={view === "flat" ? "translate(200 268) scale(0.9) translate(-200 -268)" : ""}>
        <path d={BODY[shape]} fill={`url(#g-${uid})`} />
        <path d={BODY[shape]} fill={`url(#t-${uid})`} />
        <path d={BODY[shape]} fill="none" stroke="#000" stroke-opacity="0.16" stroke-width="1.4" />

        {/* high neck on the gown */}
        {shape === "gown" && (
          <g>
            <rect x="182" y="82" width="36" height="26" rx="4"
                  fill="#000" fill-opacity="0.14" />
            <path d="M166 96 L146 118 L136 330 L156 334 L162 140 Z" fill="#000" fill-opacity="0.06" />
            <path d="M234 96 L254 118 L264 330 L244 334 L238 140 Z" fill="#000" fill-opacity="0.06" />
          </g>
        )}

        {/* jacket: collar, front opening and cuff */}
        {shape === "jacket" && (
          <g>
            <path d="M200 126 L166 98 L150 98 L186 140 Z" fill="#000" fill-opacity="0.08" />
            <path d="M200 126 L234 98 L250 98 L214 140 Z" fill="#000" fill-opacity="0.08" />
            <path d="M200 130 V342" stroke="#000" stroke-opacity="0.16" stroke-width="1.6" fill="none" />
            <path d="M102 254 L136 266" stroke="#000" stroke-opacity="0.14" stroke-width="1.6" fill="none" />
            <path d="M298 254 L264 266" stroke="#000" stroke-opacity="0.14" stroke-width="1.6" fill="none" />
          </g>
        )}

        {/* capelet: open front and shoulder line */}
        {shape === "cape" && (
          <g stroke="#000" stroke-opacity="0.15" stroke-width="1.6" fill="none">
            <path d="M200 124 V300" />
            <path d="M138 150 C168 168 232 168 262 150" />
          </g>
        )}

        {/* peplum break and sculptural buttons */}
        {shape === "top" && (
          <g>
            <path d="M143 296 H257" stroke="#000" stroke-opacity="0.16" stroke-width="1.6" fill="none" />
            {[168, 208, 248].map((cy) => (
              <circle cx="200" cy={cy} r="6" fill="#000" fill-opacity="0.30" />
            ))}
          </g>
        )}

        {/* skirt: waist seam and flute lines */}
        {shape === "skirt" && (
          <g stroke="#000" stroke-opacity="0.13" stroke-width="1.4" fill="none">
            <path d="M144 168 H256" />
            <path d="M172 190 L150 470" />
            <path d="M228 190 L250 470" />
          </g>
        )}

        {view === "flat" && (
          <g stroke="#000" stroke-opacity="0.09" stroke-width="1.2" fill="none">
            <path d="M104 300 H296" />
          </g>
        )}
      </g>

      <text x="200" y="504" text-anchor="middle" class="g-cap">
        {view === "front" ? "Front" : view === "back" ? "Back" : "Laid flat"}
      </text>
    </g>
  )}
</svg>

<style>
  .garment {
    width: 100%;
    height: auto;
    aspect-ratio: 400 / 520;
    background: var(--paper-3);
  }
  .g-cap {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--ink-3);
  }
</style>
