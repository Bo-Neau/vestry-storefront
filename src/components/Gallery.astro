---
/**
 * Four views per colourway: front, back, laid flat, fabric macro.
 *
 * Research: pages showing the garment worn from several angles plus a
 * fabric close-up consistently beat a single flat shot, and 37% of
 * benchmarked sites ship no "in scale" image at all.
 *
 * Stacked grid on desktop, swipe carousel on mobile. Both are pure CSS —
 * no carousel library, no client JS.
 */
import type { Colorway, GarmentShape } from "../data/schema.ts";
import ProductImage from "./ProductImage.astro";

interface Props {
  shape: GarmentShape;
  colorway: Colorway;
  title: string;
}
const { shape, colorway, title } = Astro.props;

const ALL_VIEWS = [
  { view: "front" as const,  label: "front view" },
  { view: "back" as const,   label: "back view" },
  { view: "flat" as const,   label: "laid flat" },
  { view: "detail" as const, label: "fabric detail" },
];

/**
 * Once a colourway has real photography, show only the views that exist.
 *
 * Padding two photographs out to four with generated drawings reads as an
 * unfinished page — worse than three honest images. Colourways with no
 * photography yet keep the full placeholder set so the layout can still be
 * reviewed before a shoot.
 */
const shot = new Set((colorway.images ?? []).map((i) => i.view));
const VIEWS = shot.size > 0
  ? ALL_VIEWS.filter((v) => shot.has(v.view))
  : ALL_VIEWS;
---

<div class="gallery">
  <ul class="gal-track">
    {VIEWS.map(({ view, label }, i) => (
      <li class="gal-item">
        <ProductImage
          colorway={colorway}
          shape={shape}
          view={view}
          alt={`${title} in ${colorway.name}, ${label}`}
          priority={i === 0}
          sizes="(max-width: 860px) 86vw, (max-width: 1320px) 42vw, 550px"
        />
      </li>
    ))}
  </ul>
  <p class="gal-hint" aria-hidden="true">Swipe for more views</p>
</div>

<style>
  .gallery { display: flex; flex-direction: column; gap: var(--sp-2); }

  .gal-track {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
  }
  .gal-item { background: var(--paper-3); overflow: hidden; }
  .gal-hint { display: none; }

  @media (max-width: 860px) {
    /* One-up swipe carousel, CSS only. */
    .gal-track {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--sp-4));
      padding-inline: var(--sp-4);
    }
    .gal-track::-webkit-scrollbar { display: none; }
    .gal-item { scroll-snap-align: center; }
    .gal-hint {
      display: block;
      font-family: var(--mono);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--ink-3);
      text-align: center;
    }
  }
</style>
