---
/**
 * The highest-value block on a clothing PDP.
 *
 * Research: 48% of apparel shoppers read reviews specifically for size
 * accuracy — reviews function as a substitute for the fitting room. So fit
 * is a first-class structured field here (reviewer height + size purchased
 * + ran small/true/large), not free text to dig through.
 *
 * The full star distribution is shown including 1- and 2-star counts. 89%
 * of benchmarked sites mishandle negative reviews; hiding them lowers trust
 * in the positive ones and lets the wrong buyer through to a return.
 */
import type { Product } from "../data/schema.ts";
import { averageRating, ratingDistribution, fitVerdict } from "../data/schema.ts";

interface Props { product: Product }
const { product } = Astro.props;

const avg = averageRating(product);
const dist = ratingDistribution(product);
const total = product.reviews.length;
const { verdict, share } = fitVerdict(product);

const VERDICT_COPY: Record<typeof verdict, string> = {
  small: "Most reviewers say this runs small — consider sizing up.",
  true:  "Most reviewers say this fits true to size.",
  large: "Most reviewers say this runs large — consider sizing down.",
};

const FIT_LABEL: Record<"small" | "true" | "large", string> = {
  small: "Ran small", true: "True to size", large: "Ran large",
};

const stars = (n: number) => "★".repeat(n) + "☆".repeat(5 - n);
const pct = (n: number) => (total === 0 ? 0 : Math.round((n / total) * 100));
---

<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <h2 id="reviews-title">Reviews</h2>

  {total === 0 ? (
    <p class="none">No reviews yet.</p>
  ) : (
    <>
      <div class="summary">
        <div class="score">
          <p class="avg">{avg.toFixed(1)}</p>
          <p class="stars" aria-hidden="true">{stars(Math.round(avg))}</p>
          <p class="of">
            <span class="sr-only">{avg.toFixed(1)} out of 5, from </span>
            {total} review{total === 1 ? "" : "s"}
          </p>
        </div>

        <ul class="dist">
          {([5, 4, 3, 2, 1] as const).map((n) => (
            <li>
              <span class="d-n">{n}★</span>
              <span class="bar"><span class="fill" style={`width: ${pct(dist[n])}%`}></span></span>
              <span class="d-c">{dist[n]}</span>
            </li>
          ))}
        </ul>

        <div class="fit-agg">
          <p class="label">Fit</p>
          <p class="fit-verdict">{VERDICT_COPY[verdict]}</p>
          <p class="fit-share">{Math.round(share * 100)}% of reviewers agree</p>
        </div>
      </div>

      <ul class="list">
        {product.reviews.map((r) => (
          <li class="review">
            <div class="r-head">
              <p class="r-stars" aria-label={`${r.rating} out of 5`}>
                <span aria-hidden="true">{stars(r.rating)}</span>
              </p>
              <h3 class="r-title">{r.title}</h3>
            </div>

            <p class="r-body">{r.body}</p>

            <dl class="r-fit">
              <div>
                <dt>Height</dt>
                <dd>{r.heightBand}</dd>
              </div>
              <div>
                <dt>Size bought</dt>
                <dd>{r.sizePurchased}</dd>
              </div>
              <div>
                <dt>Fit</dt>
                <dd class={`fit-${r.fitFeedback}`}>{FIT_LABEL[r.fitFeedback]}</dd>
              </div>
            </dl>

            <p class="r-meta">
              {r.author}
              {r.verified && <span class="ver"> · Verified buyer</span>}
              <span class="date"> · {new Date(r.date).toLocaleDateString("en-US", { month: "short", year: "numeric" })}</span>
            </p>
          </li>
        ))}
      </ul>
    </>
  )}
</section>

<style>
  .reviews { display: flex; flex-direction: column; gap: var(--sp-5); }
  .reviews h2 { font-size: var(--step-2); }
  .none { color: var(--ink-3); }

  .summary {
    display: grid;
    grid-template-columns: auto minmax(160px, 240px) minmax(200px, 1fr);
    gap: var(--sp-6);
    align-items: start;
    padding: var(--sp-5) 0;
    border-block: 1px solid var(--rule);
  }

  .score { display: flex; flex-direction: column; gap: 2px; }
  .avg { font-size: var(--step-3); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  .stars { color: var(--ink); letter-spacing: 0.08em; font-size: var(--step--1); }
  .of { font-size: var(--step--1); color: var(--ink-3); }

  .dist { list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .dist li { display: grid; grid-template-columns: 26px 1fr 22px; gap: var(--sp-2); align-items: center; }
  .d-n, .d-c {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .d-c { text-align: right; }
  .bar { display: block; height: 5px; background: var(--paper-3); border-radius: 3px; overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--ink-2); }

  .fit-agg { display: flex; flex-direction: column; gap: var(--sp-2); }
  .fit-verdict { font-size: var(--step-0); font-weight: 600; max-width: 34ch; }
  .fit-share { font-size: var(--step--1); color: var(--ink-3); }

  .list { list-style: none; display: flex; flex-direction: column; }
  .review {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-5) 0;
    border-bottom: 1px solid var(--rule);
  }
  .r-head { display: flex; flex-direction: column; gap: var(--sp-1); }
  .r-stars { font-size: var(--step--1); letter-spacing: 0.08em; }
  .r-title { font-size: var(--step-0); }
  .r-body { color: var(--ink-2); max-width: 68ch; }

  .r-fit {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    padding: var(--sp-3) 0 0;
  }
  .r-fit > div { display: flex; flex-direction: column; gap: 1px; }
  .r-fit dt {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-3);
  }
  .r-fit dd { margin: 0; font-size: var(--step--1); font-weight: 600; }
  .fit-small { color: var(--low-stock); }
  .fit-large { color: var(--low-stock); }
  .fit-true  { color: var(--in-stock); }

  .r-meta { font-size: var(--step--1); color: var(--ink-3); }
  .ver { color: var(--in-stock); }

  @media (max-width: 760px) {
    .summary { grid-template-columns: minmax(0, 1fr); gap: var(--sp-4); }
  }
</style>
