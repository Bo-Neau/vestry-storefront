---
import "../styles/base.css";
import { BRAND } from "../config/brand.ts";
import { isIndexable } from "../config/env.ts";
import { COLLECTIONS } from "../data/collections.ts";

interface Props {
  title: string;
  description: string;
  /** Set on variant URLs so colourway pages don't split ranking signals. */
  canonical?: string | undefined;
  /**
   * Keep this page out of the index. Set on filtered collection views and
   * error pages — see the noindex note below.
   */
  noindex?: boolean | undefined;
  /** Absolute URL of the social preview image. */
  ogImage?: string | undefined;
  ogType?: "website" | "article" | undefined;
}
const {
  title, description, canonical, noindex = false,
  ogImage, ogType = "website",
} = Astro.props;

const site = Astro.site ?? new URL("https://example.com");
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
const socialImage = new URL(ogImage ?? "/og-default.svg", site).href;

// Preview and development deployments are never indexable, whatever the page
// asks for. A client-review branch must not compete with the live site.
const blockIndexing = noindex || !isIndexable();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />

    {/*
      Filtered collection views are combinatorially infinite — every
      size x fit x colour combination is its own URL. Letting them into the
      index burns crawl budget on near-duplicate pages and splits ranking
      signals across variants of the same collection. The facet links also
      carry rel="nofollow".
    */}
    {blockIndexing && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <div class="shell head-inner">
        <a href="/" class="brand" aria-label={`${BRAND.name} — home`}>
          <img src="/brand/logo-mark.png" alt="" width="28" height="28" class="brand-mark" />
          <span>{BRAND.name}</span>
        </a>

        <nav aria-label="Sections" class="sections">
          <ul class="nav">
            <li><a href="/collections">Collections</a></li>
            <li><a href="/designers">Designers</a></li>
            <li><a href="/atelier">Atelier</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="shell foot-inner">
        <div class="foot-col">
          <p class="label">Collections</p>
          <ul>
            {COLLECTIONS.slice(0, 3).map((c) => (
              <li><a href={`/collections/${c.handle}`}>{c.title}</a></li>
            ))}
          </ul>
        </div>
        <div class="foot-col">
          <p class="label">The house</p>
          <ul>
            <li><a href="/designers">Designers</a></li>
            <li><a href="/atelier">Atelier</a></li>
            <li><a href="/collections">All collections</a></li>
          </ul>
        </div>
        <p class="foot-note">
          {BRAND.legalName} &middot; Yangon. Pieces are shown as documented in
          the collection booklet and are not currently offered for sale.
        </p>
      </div>
    </footer>

    <style>
      .site-head {
        border-bottom: 1px solid var(--rule);
        background: var(--paper);
        position: sticky;
        top: 0;
        z-index: 20;
      }
      .head-inner {
        display: flex;
        align-items: center;
        gap: var(--sp-6);
        min-height: 64px;
        flex-wrap: wrap;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        font-family: var(--display);
        font-size: var(--step-1);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.2em;
      }
      /* The mark is drawn dark; invert it when the page ground goes dark. */
      .brand-mark { width: 26px; height: 26px; object-fit: contain; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .brand-mark { filter: invert(1) brightness(1.6); }
      }
      :root[data-theme="dark"] .brand-mark { filter: invert(1) brightness(1.6); }
      .brand:hover { text-decoration: none; }
      .nav {
        display: flex;
        gap: var(--sp-5);
        list-style: none;
        flex-wrap: wrap;
      }
      .nav a {
        font-size: var(--step--1);
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--ink-2);
        /* 44px tap height without changing the visual rhythm. */
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }
      .nav a:hover { color: var(--ink); }
      @media (max-width: 860px) {
        /*
          Mobile header: two rows.

          Row 1  brand
          Row 2  sections, one scrollable line

          Losing the bag freed the top-right corner, so the brand now has the
          whole first row and the nav gets a full line to scroll in.
        */
        .head-inner {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          grid-template-areas:
            "brand"
            "nav";
          gap: var(--sp-2) var(--sp-3);
          align-items: center;
          min-height: 0;
          padding-block: var(--sp-3);
        }
        .brand {
          grid-area: brand;
          font-size: var(--step-0);
          letter-spacing: 0.16em;
        }
        nav { grid-area: nav; min-width: 0; }
        .nav {
          gap: var(--sp-4);
          overflow-x: auto;
          flex-wrap: nowrap;
          scrollbar-width: none;
          /* Bleed to the edges so the scroll affordance is obvious and the
             last item is not clipped mid-word against the padding. */
          margin-inline: calc(-1 * var(--sp-4));
          padding-inline: var(--sp-4);
        }
        .nav::-webkit-scrollbar { display: none; }
        .nav a { white-space: nowrap; }
      }

      .site-foot {
        border-top: 1px solid var(--rule);
        margin-top: var(--sp-8);
        padding: var(--sp-7) 0 var(--sp-8);
      }
      .foot-inner {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: var(--sp-6);
        align-items: start;
      }
      .foot-col ul { list-style: none; display: flex; flex-direction: column; margin-top: var(--sp-2); }
      .foot-col a {
        font-size: var(--step--1);
        color: var(--ink-2);
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }
      .foot-note {
        grid-column: 1 / -1;
        font-size: var(--step--1);
        color: var(--ink-3);
        max-width: 56ch;
        border-top: 1px solid var(--rule);
        padding-top: var(--sp-4);
      }
    </style>
  </body>
</html>
